/**
 * 01_Util.js
 * Shared helpers: errors, ids, time, responses, validation.
 */

/** Application error with a stable, client-safe code. Never carries stack traces to the client. */
function AppError(code, message, status) {
  this.name = 'AppError';
  this.code = code || 'INTERNAL_ERROR';
  this.message = message || 'An unexpected error occurred.';
  this.status = status || 400;
}
AppError.prototype = Object.create(Error.prototype);

var ERR = {
  UNAUTHENTICATED: 'UNAUTHENTICATED',
  UNAUTHORIZED: 'UNAUTHORIZED',
  FORBIDDEN: 'FORBIDDEN',
  VALIDATION: 'VALIDATION_ERROR',
  NOT_FOUND: 'NOT_FOUND',
  CONFLICT: 'CONFLICT',
  INSUFFICIENT_STOCK: 'INSUFFICIENT_STOCK',
  INVALID_TRANSITION: 'INVALID_TRANSITION',
  LOCKED: 'LOCKED',
  INTERNAL: 'INTERNAL_ERROR',
  CONFIG: 'CONFIGURATION_ERROR'
};

function fail(code, message, status) { throw new AppError(code, message, status); }

function nowIso() { return new Date().toISOString(); }

function toIsoDate(value) {
  // Accepts Date, ISO string, or yyyy-mm-dd and returns yyyy-mm-dd (or '' when empty).
  if (value === null || value === undefined || value === '') return '';
  if (value instanceof Date) {
    if (isNaN(value.getTime())) return '';
    var y = value.getFullYear(), m = ('0' + (value.getMonth() + 1)).slice(-2), d = ('0' + value.getDate()).slice(-2);
    return y + '-' + m + '-' + d;
  }
  var s = String(value).trim();
  if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0, 10);
  var dt = new Date(s);
  return isNaN(dt.getTime()) ? '' : toIsoDate(dt);
}

function newId(prefix) {
  var raw = Utilities.getUuid().replace(/-/g, '').slice(0, 20);
  return (prefix ? prefix + '_' : '') + raw;
}

function pad(n, width) {
  var s = String(n);
  while (s.length < width) s = '0' + s;
  return s;
}

function toBool(v) {
  if (typeof v === 'boolean') return v;
  var s = String(v === undefined || v === null ? '' : v).trim().toLowerCase();
  return s === 'true' || s === 'yes' || s === '1';
}

function toNum(v, fallback) {
  if (v === '' || v === null || v === undefined) return fallback === undefined ? 0 : fallback;
  var n = Number(v);
  return isNaN(n) ? (fallback === undefined ? 0 : fallback) : n;
}

function isNonEmptyString(v) { return typeof v === 'string' && v.trim().length > 0; }

function requireString(obj, key, label, maxLen) {
  var v = obj ? obj[key] : undefined;
  if (!isNonEmptyString(v)) fail(ERR.VALIDATION, (label || key) + ' is required.');
  v = String(v).trim();
  if (maxLen && v.length > maxLen) fail(ERR.VALIDATION, (label || key) + ' must be at most ' + maxLen + ' characters.');
  return v;
}

function optionalString(obj, key, maxLen) {
  var v = obj ? obj[key] : undefined;
  if (v === undefined || v === null) return '';
  v = String(v).trim();
  if (maxLen && v.length > maxLen) fail(ERR.VALIDATION, key + ' must be at most ' + maxLen + ' characters.');
  return v;
}

function requirePositiveInt(value, label) {
  var n = Number(value);
  if (!isFinite(n) || n <= 0 || Math.floor(n) !== n) fail(ERR.VALIDATION, (label || 'Quantity') + ' must be a positive whole number.');
  return n;
}

function requireNonNegativeInt(value, label) {
  var n = Number(value);
  if (!isFinite(n) || n < 0 || Math.floor(n) !== n) fail(ERR.VALIDATION, (label || 'Quantity') + ' must be a whole number of zero or more.');
  return n;
}

function requireDate(value, label) {
  var d = toIsoDate(value);
  if (!d) fail(ERR.VALIDATION, (label || 'Date') + ' must be a valid date (yyyy-mm-dd).');
  return d;
}

function isValidEmail(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(email || '').trim());
}

function normalizeEmail(email) { return String(email || '').trim().toLowerCase(); }

function ok(data, message, requestId) {
  return { success: true, data: data === undefined ? null : data, message: message || '', error: null, requestId: requestId || null };
}

function errorResponse(err, requestId) {
  var isApp = err && err.name === 'AppError';
  var code = isApp ? err.code : ERR.INTERNAL;
  var message = isApp ? err.message : 'An unexpected error occurred. Please try again or contact an administrator.';
  if (!isApp) {
    try { console.error('Unhandled error [' + (requestId || '-') + ']: ' + (err && err.stack ? err.stack : err)); } catch (e) { /* ignore */ }
  }
  return { success: false, data: null, message: message, error: { code: code, message: message }, requestId: requestId || null };
}

function uniq(arr) {
  var seen = {}, out = [];
  (arr || []).forEach(function (v) { if (!seen[v]) { seen[v] = true; out.push(v); } });
  return out;
}

function indexBy(rows, key) {
  var map = {};
  (rows || []).forEach(function (r) { map[r[key]] = r; });
  return map;
}

function groupBy(rows, key) {
  var map = {};
  (rows || []).forEach(function (r) { (map[r[key]] = map[r[key]] || []).push(r); });
  return map;
}

function inDateRange(dateValue, from, to) {
  var d = toIsoDate(dateValue);
  if (!d) return false;
  if (from && d < toIsoDate(from)) return false;
  if (to && d > toIsoDate(to)) return false;
  return true;
}

function monthKey(dateValue) {
  var d = toIsoDate(dateValue);
  return d ? d.slice(0, 7) : '';
}

function safeJsonParse(text, fallback) {
  try { return JSON.parse(text); } catch (e) { return fallback; }
}

function paginate(rows, params) {
  var page = Math.max(1, Math.floor(toNum(params && params.page, 1)));
  var pageSize = Math.min(200, Math.max(1, Math.floor(toNum(params && params.pageSize, 25))));
  var total = rows.length;
  var start = (page - 1) * pageSize;
  return { rows: rows.slice(start, start + pageSize), page: page, pageSize: pageSize, total: total, totalPages: Math.max(1, Math.ceil(total / pageSize)) };
}

function sortRows(rows, sortBy, sortDir) {
  if (!sortBy) return rows;
  var dir = String(sortDir || 'asc').toLowerCase() === 'desc' ? -1 : 1;
  return rows.slice().sort(function (a, b) {
    var av = a[sortBy], bv = b[sortBy];
    var an = Number(av), bn = Number(bv);
    if (av !== '' && bv !== '' && av !== undefined && bv !== undefined && !isNaN(an) && !isNaN(bn)) return (an - bn) * dir;
    av = String(av === undefined || av === null ? '' : av).toLowerCase();
    bv = String(bv === undefined || bv === null ? '' : bv).toLowerCase();
    return av < bv ? -dir : av > bv ? dir : 0;
  });
}

function textMatches(row, keys, query) {
  if (!query) return true;
  var q = String(query).toLowerCase();
  return keys.some(function (k) { return String(row[k] === undefined || row[k] === null ? '' : row[k]).toLowerCase().indexOf(q) !== -1; });
}


// ===================== 02_Sheets.js =====================
/**
 * 02_Sheets.js
 * Spreadsheet access layer. All reads/writes to managed worksheets go through here.
 *
 * Design notes
 * - Every managed worksheet has a header row defined in SCHEMA (00_Config.js).
 * - Rows are addressed by their stable ID column (ID_COLUMNS), never by row number from the client.
 * - All columns are formatted as plain text ('@') when a sheet is created so ISO timestamps are not
 *   silently converted into Sheets date serials. Numbers are coerced on read with toNum().
 * - Legacy worksheets (East_Inventory, Distribution) are never written by this backend.
 */

var __ssCache = null;
var __tableCache = {};

function getProps() { return PropertiesService.getScriptProperties(); }

function getSpreadsheetId() {
  var id = getProps().getProperty('SPREADSHEET_ID');
  return id || CONFIG.DEFAULT_SPREADSHEET_ID;
}

function getSpreadsheet() {
  if (__ssCache) return __ssCache;
  var id = getSpreadsheetId();
  if (!id) fail(ERR.CONFIG, 'Spreadsheet ID is not configured.', 500);
  try {
    __ssCache = SpreadsheetApp.openById(id);
  } catch (e) {
    fail(ERR.CONFIG, 'The inventory spreadsheet could not be opened. Check the SPREADSHEET_ID property and sharing.', 500);
  }
  return __ssCache;
}

/** Clears per-execution caches. Called at the start of each request and after bulk writes. */
function resetSheetCaches() { __tableCache = {}; }

/** Drops the spreadsheet handle too. Called once at the start of every request. */
function resetAllCaches() { __tableCache = {}; __ssCache = null; }

function getOrCreateSheet(name) {
  var ss = getSpreadsheet();
  var sheet = ss.getSheetByName(name);
  if (sheet) return sheet;
  if (!SCHEMA[name]) fail(ERR.CONFIG, 'Unknown worksheet: ' + name, 500);
  sheet = ss.insertSheet(name);
  var headers = SCHEMA[name];
  sheet.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold');
  sheet.getRange(1, 1, Math.max(sheet.getMaxRows(), 2), headers.length).setNumberFormat('@');
  sheet.setFrozenRows(1);
  return sheet;
}

/** Ensures every managed worksheet exists with the expected header row. Appends missing columns. */
function ensureSchema() {
  var report = [];
  Object.keys(SCHEMA).forEach(function (name) {
    var sheet = getOrCreateSheet(name);
    var expected = SCHEMA[name];
    var lastCol = sheet.getLastColumn();
    var existing = lastCol > 0 ? sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(String) : [];
    var missing = expected.filter(function (h) { return existing.indexOf(h) === -1; });
    if (missing.length) {
      sheet.getRange(1, existing.length + 1, 1, missing.length).setValues([missing]).setFontWeight('bold');
      sheet.getRange(1, existing.length + 1, Math.max(sheet.getMaxRows(), 2), missing.length).setNumberFormat('@');
    }
    report.push({ sheet: name, addedColumns: missing });
  });
  resetSheetCaches();
  return report;
}

/**
 * Table wrapper around a worksheet.
 * read() returns plain objects keyed by header; each object also carries a non-enumerable _row.
 */
function table(name) {
  if (__tableCache[name]) return __tableCache[name];
  var sheet = getOrCreateSheet(name);
  var lastCol = sheet.getLastColumn();
  var headers = lastCol > 0 ? sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(String) : SCHEMA[name].slice();
  var idCol = ID_COLUMNS[name];
  var t = {
    name: name,
    sheet: sheet,
    headers: headers,
    idColumn: idCol,
    _rows: null,

    read: function () {
      if (this._rows) return this._rows;
      var lastRow = sheet.getLastRow();
      var out = [];
      if (lastRow >= 2) {
        var values = sheet.getRange(2, 1, lastRow - 1, headers.length).getValues();
        for (var i = 0; i < values.length; i++) {
          var row = values[i];
          var obj = {};
          var empty = true;
          for (var c = 0; c < headers.length; c++) {
            var v = row[c];
            if (v instanceof Date) v = v.toISOString();
            obj[headers[c]] = v;
            if (v !== '' && v !== null && v !== undefined) empty = false;
          }
          if (empty) continue;
          Object.defineProperty(obj, '_row', { value: i + 2, enumerable: false });
          out.push(obj);
        }
      }
      this._rows = out;
      return out;
    },

    findById: function (id) {
      if (id === undefined || id === null || id === '') return null;
      var rows = this.read();
      for (var i = 0; i < rows.length; i++) if (String(rows[i][idCol]) === String(id)) return rows[i];
      return null;
    },

    where: function (pred) { return this.read().filter(pred); },

    toRow: function (obj) {
      return headers.map(function (h) {
        var v = obj[h];
        if (v === undefined || v === null) return '';
        if (typeof v === 'boolean') return v ? 'TRUE' : 'FALSE';
        if (typeof v === 'object') return JSON.stringify(v);
        return v;
      });
    },

    append: function (objs) {
      var list = Array.isArray(objs) ? objs : [objs];
      if (!list.length) return [];
      var self = this;
      var values = list.map(function (o) { return self.toRow(o); });
      var startRow = sheet.getLastRow() + 1;
      sheet.getRange(startRow, 1, values.length, headers.length).setValues(values);
      this._rows = null; // force re-read so _row indexes stay correct
      return list;
    },

    update: function (id, patch) {
      var existing = this.findById(id);
      if (!existing) fail(ERR.NOT_FOUND, name + ' record not found: ' + id, 404);
      var merged = {};
      headers.forEach(function (h) { merged[h] = existing[h]; });
      Object.keys(patch || {}).forEach(function (k) { if (headers.indexOf(k) !== -1) merged[k] = patch[k]; });
      sheet.getRange(existing._row, 1, 1, headers.length).setValues([this.toRow(merged)]);
      Object.defineProperty(merged, '_row', { value: existing._row, enumerable: false });
      // keep in-memory copy in sync
      var rows = this._rows;
      if (rows) for (var i = 0; i < rows.length; i++) if (rows[i]._row === existing._row) { rows[i] = merged; break; }
      return merged;
    },

    /** Batch update many rows by id in one pass (one setValues per contiguous row). */
    updateMany: function (patches) {
      var self = this;
      Object.keys(patches).forEach(function (id) { self.update(id, patches[id]); });
    },

    count: function () { return this.read().length; }
  };
  __tableCache[name] = t;
  return t;
}

/** Reads a legacy worksheet (read only) into objects keyed by its own header row. */
function readLegacySheet(name) {
  var ss = getSpreadsheet();
  var sheet = ss.getSheetByName(name);
  if (!sheet) return { headers: [], rows: [] };
  var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
  if (lastRow < 1 || lastCol < 1) return { headers: [], rows: [] };
  var values = sheet.getRange(1, 1, lastRow, lastCol).getValues();
  var headers = values[0].map(String);
  var rows = [];
  for (var i = 1; i < values.length; i++) {
    var obj = {}, empty = true;
    for (var c = 0; c < headers.length; c++) {
      var v = values[i][c];
      if (v instanceof Date) v = toIsoDate(v);
      obj[headers[c]] = v;
      if (v !== '' && v !== null) empty = false;
    }
    if (!empty) rows.push(obj);
  }
  return { headers: headers, rows: rows };
}

/* ---------- Settings ---------- */

function getSettings() {
  var cache = CacheService.getScriptCache();
  var cached = cache.get('settings');
  if (cached) return JSON.parse(cached);
  var map = {};
  DEFAULT_SETTINGS.forEach(function (s) { map[s.key] = s.value; });
  table(SHEETS.SETTINGS).read().forEach(function (r) { map[r.key] = String(r.value); });
  cache.put('settings', JSON.stringify(map), 300);
  return map;
}

function getSetting(key) { return getSettings()[key]; }
function getSettingBool(key) { return toBool(getSetting(key)); }
function invalidateSettingsCache() { CacheService.getScriptCache().remove('settings'); }

/* ---------- Locking ---------- */

/** Runs fn while holding the script lock. Every stock-mutating operation must use this. */
function withLock(fn) {
  var lock = LockService.getScriptLock();
  var acquired = false;
  try {
    acquired = lock.tryLock(CONFIG.LOCK_TIMEOUT_MS);
  } catch (e) { acquired = false; }
  if (!acquired) fail(ERR.LOCKED, 'The system is busy processing another change. Please try again in a moment.', 423);
  try {
    resetSheetCaches(); // always read fresh data inside the lock
    return fn();
  } finally {
    try { lock.releaseLock(); } catch (e) { /* ignore */ }
  }
}

/* ---------- Reference numbers ---------- */

/** Generates a human-readable, unique reference such as REQ-2026-0001 (call inside withLock). */
function nextReference(sheetName, columnName, prefix) {
  var year = new Date().getFullYear();
  var head = prefix + '-' + year + '-';
  var max = 0;
  table(sheetName).read().forEach(function (r) {
    var ref = String(r[columnName] || '');
    if (ref.indexOf(head) === 0) {
      var n = parseInt(ref.slice(head.length), 10);
      if (!isNaN(n) && n > max) max = n;
    }
  });
  return head + pad(max + 1, 4);
}


// ===================== 03_Auth.js =====================
/**
 * 03_Auth.js
 * Authentication and authorization.
 *
 * Flow
 * 1. Browser obtains a Google ID token via Google Identity Services (no client secret involved).
 * 2. auth.login sends the ID token. We verify it with Google's tokeninfo endpoint over HTTPS
 *    (signature, issuer, audience, expiry, email_verified are all checked by Google and re-checked here).
 * 3. The verified email is looked up in AuthorizedUsers. Unknown or inactive accounts are rejected.
 * 4. A session token (HMAC-SHA256 signed, secret in Script Properties) is returned to the browser.
 * 5. Every later call carries the session token in the request body. We verify the signature + expiry
 *    and re-load the user so deactivation / role changes take effect immediately.
 *
 * The browser NEVER supplies its own email or role; both come from verified Google identity and the sheet.
 */

var TOKENINFO_URL = 'https://oauth2.googleapis.com/tokeninfo?id_token=';

function getSessionSecret() {
  var secret = getProps().getProperty('SESSION_SECRET');
  if (!secret || secret.length < 32) fail(ERR.CONFIG, 'Session secret is not configured. Run setup() in the Apps Script editor.', 500);
  return secret;
}

function getGoogleClientId() {
  var id = getProps().getProperty('GOOGLE_CLIENT_ID');
  if (!id) fail(ERR.CONFIG, 'GOOGLE_CLIENT_ID is not configured in Script Properties.', 500);
  return id;
}

function base64UrlEncode(bytesOrString) {
  var b64 = typeof bytesOrString === 'string'
    ? Utilities.base64EncodeWebSafe(bytesOrString, Utilities.Charset.UTF_8)
    : Utilities.base64EncodeWebSafe(bytesOrString);
  return b64.replace(/=+$/, '');
}

function base64UrlDecodeToString(s) {
  var bytes = Utilities.base64DecodeWebSafe(s, Utilities.Charset.UTF_8);
  return Utilities.newBlob(bytes).getDataAsString('UTF-8');
}

function hmacSign(payloadB64, secret) {
  var sig = Utilities.computeHmacSha256Signature(payloadB64, secret, Utilities.Charset.UTF_8);
  return base64UrlEncode(sig);
}

function constantTimeEqual(a, b) {
  if (typeof a !== 'string' || typeof b !== 'string' || a.length !== b.length) return false;
  var diff = 0;
  for (var i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}

function issueSessionToken(user) {
  var now = Math.floor(Date.now() / 1000);
  var payload = { sub: user.email, uid: user.userId, iat: now, exp: now + CONFIG.SESSION_TTL_SECONDS, n: Utilities.getUuid().slice(0, 8) };
  var payloadB64 = base64UrlEncode(JSON.stringify(payload));
  return payloadB64 + '.' + hmacSign(payloadB64, getSessionSecret());
}

function parseSessionToken(token) {
  if (!isNonEmptyString(token)) fail(ERR.UNAUTHENTICATED, 'Please sign in.', 401);
  var parts = token.split('.');
  if (parts.length !== 2) fail(ERR.UNAUTHENTICATED, 'Invalid session. Please sign in again.', 401);
  var expected = hmacSign(parts[0], getSessionSecret());
  if (!constantTimeEqual(expected, parts[1])) fail(ERR.UNAUTHENTICATED, 'Invalid session. Please sign in again.', 401);
  var payload = safeJsonParse(base64UrlDecodeToString(parts[0]), null);
  if (!payload || !payload.sub || !payload.exp) fail(ERR.UNAUTHENTICATED, 'Invalid session. Please sign in again.', 401);
  if (payload.exp < Math.floor(Date.now() / 1000)) fail(ERR.UNAUTHENTICATED, 'Your session has expired. Please sign in again.', 401);
  return payload;
}

/** Verifies a Google ID token with Google. Returns { email, name, picture, sub }. */
function verifyGoogleIdToken(idToken) {
  if (!isNonEmptyString(idToken) || idToken.length > 4096) fail(ERR.UNAUTHENTICATED, 'Google sign-in token is missing.', 401);
  var resp;
  try {
    resp = UrlFetchApp.fetch(TOKENINFO_URL + encodeURIComponent(idToken), { muteHttpExceptions: true, followRedirects: false });
  } catch (e) {
    fail(ERR.INTERNAL, 'Google identity verification is temporarily unavailable.', 503);
  }
  if (resp.getResponseCode() !== 200) fail(ERR.UNAUTHENTICATED, 'Google sign-in could not be verified. Please try again.', 401);
  var info = safeJsonParse(resp.getContentText(), null);
  if (!info || !info.email) fail(ERR.UNAUTHENTICATED, 'Google sign-in could not be verified.', 401);

  var clientId = getGoogleClientId();
  if (String(info.aud) !== clientId) fail(ERR.UNAUTHENTICATED, 'Sign-in token was not issued for this application.', 401);
  if (['accounts.google.com', 'https://accounts.google.com'].indexOf(String(info.iss)) === -1) fail(ERR.UNAUTHENTICATED, 'Sign-in token has an invalid issuer.', 401);
  if (toNum(info.exp) < Math.floor(Date.now() / 1000)) fail(ERR.UNAUTHENTICATED, 'Sign-in token has expired. Please try again.', 401);
  if (!toBool(info.email_verified)) fail(ERR.UNAUTHENTICATED, 'Your Google email address is not verified.', 401);

  return { email: normalizeEmail(info.email), name: info.name || '', picture: info.picture || '', sub: info.sub || '' };
}

/* ---------- Authorized users ---------- */

function publicUser(u, congregation) {
  return {
    userId: u.userId,
    email: u.email,
    name: u.name || '',
    role: u.role,
    congregationId: u.congregationId || '',
    congregationName: congregation ? congregation.name : '',
    congregationCode: congregation ? congregation.code : '',
    active: toBool(u.active),
    lastLoginAt: u.lastLoginAt || '',
    permissions: permissionsForRole(u.role)
  };
}

function permissionsForRole(role) {
  return Object.keys(PERMISSIONS).filter(function (p) { return PERMISSIONS[p].indexOf(role) !== -1; });
}

function findUserByEmail(email) {
  email = normalizeEmail(email);
  var cache = CacheService.getScriptCache();
  var key = 'user:' + email;
  var cached = cache.get(key);
  if (cached) return JSON.parse(cached);
  var user = null;
  table(SHEETS.USERS).read().forEach(function (u) { if (normalizeEmail(u.email) === email) user = u; });
  if (user) cache.put(key, JSON.stringify(user), CONFIG.USER_CACHE_TTL_SECONDS);
  return user;
}

function invalidateUserCache(email) {
  CacheService.getScriptCache().remove('user:' + normalizeEmail(email));
}

/** Seeds the initial administrator when no users exist. Safe to call repeatedly. */
function seedInitialAdmin(actor) {
  var users = table(SHEETS.USERS);
  if (users.count() > 0) return null;
  var now = nowIso();
  var admin = {
    userId: newId('usr'), email: normalizeEmail(CONFIG.INITIAL_ADMIN_EMAIL), name: 'Initial Administrator',
    role: ROLES.ADMIN, congregationId: '', active: 'TRUE', createdAt: now, createdBy: actor || 'setup', updatedAt: now, updatedBy: actor || 'setup', lastLoginAt: ''
  };
  users.append(admin);
  invalidateUserCache(admin.email);
  return admin;
}

/** Resolves the acting user from a session token. Throws if unauthenticated or deactivated. */
function authenticate(token) {
  var payload = parseSessionToken(token);
  var user = findUserByEmail(payload.sub);
  if (!user) fail(ERR.UNAUTHORIZED, 'Your account is no longer authorized.', 403);
  if (!toBool(user.active)) fail(ERR.UNAUTHORIZED, 'Your account has been deactivated. Contact an administrator.', 403);
  if (ALL_ROLES.indexOf(user.role) === -1) fail(ERR.UNAUTHORIZED, 'Your account has an invalid role. Contact an administrator.', 403);
  return user;
}

function hasPermission(user, permission) {
  var roles = PERMISSIONS[permission];
  return !!roles && roles.indexOf(user.role) !== -1;
}

function requirePermission(user, permission) {
  if (!hasPermission(user, permission)) fail(ERR.FORBIDDEN, 'You do not have permission to perform this action.', 403);
}

/** Either "all" permission, or "own" permission scoped to the user's congregation. Returns the scope. */
function requireScope(user, allPermission, ownPermission) {
  if (hasPermission(user, allPermission)) return { all: true, congregationId: null };
  if (hasPermission(user, ownPermission)) {
    if (!user.congregationId) fail(ERR.FORBIDDEN, 'Your account is not linked to a congregation. Contact an administrator.', 403);
    return { all: false, congregationId: user.congregationId };
  }
  fail(ERR.FORBIDDEN, 'You do not have permission to view this information.', 403);
}

function assertScopeCongregation(scope, congregationId) {
  if (!scope.all && String(scope.congregationId) !== String(congregationId)) {
    fail(ERR.FORBIDDEN, 'You may only access records for your own congregation.', 403);
  }
}

/* ---------- Auth actions ---------- */

function authLogin(params, ctx) {
  var identity = verifyGoogleIdToken(params && params.idToken);
  var user = findUserByEmail(identity.email);
  if (!user && table(SHEETS.USERS).count() === 0 && identity.email === normalizeEmail(CONFIG.INITIAL_ADMIN_EMAIL)) {
    user = seedInitialAdmin(identity.email);
  }
  if (!user) fail(ERR.UNAUTHORIZED, 'This Google account is not authorized to use the system. Contact the administrator.', 403);
  if (!toBool(user.active)) fail(ERR.UNAUTHORIZED, 'Your account has been deactivated. Contact an administrator.', 403);

  var now = nowIso();
  var patch = { lastLoginAt: now, updatedAt: user.updatedAt || now };
  if (!user.name && identity.name) patch.name = identity.name;
  user = table(SHEETS.USERS).update(user.userId, patch);
  invalidateUserCache(user.email);
  writeAudit(user.email, 'auth.login', 'AuthorizedUsers', user.userId, 'Signed in', ctx.requestId, null);

  var congregation = user.congregationId ? table(SHEETS.CONGREGATIONS).findById(user.congregationId) : null;
  return { token: issueSessionToken(user), user: publicUser(user, congregation), expiresInSeconds: CONFIG.SESSION_TTL_SECONDS };
}

function authMe(params, ctx) {
  var user = ctx.user;
  var congregation = user.congregationId ? table(SHEETS.CONGREGATIONS).findById(user.congregationId) : null;
  return publicUser(user, congregation);
}

function authLogout(params, ctx) {
  writeAudit(ctx.user.email, 'auth.logout', 'AuthorizedUsers', ctx.user.userId, 'Signed out', ctx.requestId, null);
  return { loggedOut: true };
}


// ===================== 04_Audit.js =====================
/**
 * 04_Audit.js
 * Audit logging and idempotency protection.
 */

function writeAudit(actor, action, entityType, entityId, summary, requestId, details) {
  try {
    table(SHEETS.AUDIT).append({
      auditId: newId('aud'), timestamp: nowIso(), actor: actor || '', action: action || '', entityType: entityType || '',
      entityId: entityId || '', summary: summary || '', requestId: requestId || '',
      details: details ? JSON.stringify(details).slice(0, 5000) : ''
    });
  } catch (e) {
    try { console.error('Audit write failed: ' + e); } catch (ignored) { /* ignore */ }
  }
}

function auditList(params, ctx) {
  requirePermission(ctx.user, 'audit.view');
  var rows = table(SHEETS.AUDIT).read().filter(function (r) {
    if (params.actor && normalizeEmail(r.actor) !== normalizeEmail(params.actor)) return false;
    if (params.action && String(r.action).indexOf(params.action) !== 0) return false;
    if ((params.from || params.to) && !inDateRange(r.timestamp, params.from, params.to)) return false;
    return textMatches(r, ['actor', 'action', 'entityType', 'entityId', 'summary'], params.query);
  });
  rows = sortRows(rows, params.sortBy || 'timestamp', params.sortDir || 'desc');
  return paginate(rows, params);
}

/* ---------- Idempotency ----------
 * Mutating actions must send a client-generated requestId (UUID). If the same actor retries the same
 * requestId, the stored response is returned and no second write happens. Checked inside withLock().
 */

function idempotencyKey(ctx) { return normalizeEmail(ctx.user.email) + ':' + ctx.requestId; }

function findIdempotentResponse(ctx, action) {
  var key = idempotencyKey(ctx);
  var cache = CacheService.getScriptCache();
  var cached = cache.get('idem:' + key);
  if (cached) return JSON.parse(cached);
  var row = table(SHEETS.IDEMPOTENCY).findById(key);
  if (row) {
    var parsed = safeJsonParse(row.responseJson, null);
    if (parsed) return parsed;
  }
  return null;
}

function storeIdempotentResponse(ctx, action, response) {
  var key = idempotencyKey(ctx);
  var json = JSON.stringify(response);
  try { CacheService.getScriptCache().put('idem:' + key, json, CONFIG.IDEMPOTENCY_TTL_SECONDS); } catch (e) { /* ignore */ }
  try {
    table(SHEETS.IDEMPOTENCY).append({ key: key, action: action, actor: ctx.user.email, createdAt: nowIso(), responseJson: json.slice(0, 40000) });
  } catch (e) {
    try { console.error('Idempotency write failed: ' + e); } catch (ignored) { /* ignore */ }
  }
}

/** Wraps a mutating handler with lock + idempotency. The handler runs at most once per (actor, requestId). */
function runMutation(action, ctx, fn) {
  if (!isNonEmptyString(ctx.requestId) || ctx.requestId.length < 8 || ctx.requestId.length > 128) {
    fail(ERR.VALIDATION, 'A unique requestId is required for this operation.');
  }
  return withLock(function () {
    var previous = findIdempotentResponse(ctx, action);
    if (previous) return previous;
    var result = fn();
    storeIdempotentResponse(ctx, action, result);
    return result;
  });
}


// ===================== 05_Congregations.js =====================
/**
 * 05_Congregations.js
 * Congregation master data. The coordinator (East) is the only congregation that holds physical stock
 * in this system; member congregations receive distributions.
 */

function listCongregations(includeInactive) {
  return table(SHEETS.CONGREGATIONS).read()
    .filter(function (c) { return includeInactive || toBool(c.active); })
    .map(publicCongregation);
}

function publicCongregation(c) {
  return {
    congregationId: c.congregationId, code: c.code, name: c.name, type: c.type || 'member',
    active: toBool(c.active), notes: c.notes || '', createdAt: c.createdAt || '', updatedAt: c.updatedAt || ''
  };
}

function getCoordinatorCongregation() {
  var rows = table(SHEETS.CONGREGATIONS).read();
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].type === 'coordinator' || String(rows[i].code).toUpperCase() === CONFIG.COORDINATOR_CONGREGATION_CODE) return rows[i];
  }
  fail(ERR.CONFIG, 'The coordinating congregation is not configured. Run setup().', 500);
}

function requireCongregation(congregationId, label) {
  if (!isNonEmptyString(congregationId)) fail(ERR.VALIDATION, (label || 'Congregation') + ' is required.');
  var c = table(SHEETS.CONGREGATIONS).findById(congregationId);
  if (!c) fail(ERR.NOT_FOUND, (label || 'Congregation') + ' not found.', 404);
  if (!toBool(c.active)) fail(ERR.VALIDATION, (label || 'Congregation') + ' is inactive.');
  return c;
}

function congregationsList(params, ctx) {
  requirePermission(ctx.user, 'congregations.view');
  var includeInactive = toBool(params.includeInactive) && hasPermission(ctx.user, 'congregations.manage');
  return listCongregations(includeInactive);
}

function congregationsSave(params, ctx) {
  requirePermission(ctx.user, 'congregations.manage');
  var t = table(SHEETS.CONGREGATIONS);
  var now = nowIso();
  var code = requireString(params, 'code', 'Code', 20).toUpperCase();
  var name = requireString(params, 'name', 'Name', 120);
  var type = optionalString(params, 'type') || 'member';
  if (['coordinator', 'member', 'supplier'].indexOf(type) === -1) fail(ERR.VALIDATION, 'Type must be coordinator, member or supplier.');
  var notes = optionalString(params, 'notes', 500);

  var duplicate = t.read().filter(function (c) { return String(c.code).toUpperCase() === code && c.congregationId !== params.congregationId; });
  if (duplicate.length) fail(ERR.CONFLICT, 'A congregation with code ' + code + ' already exists.', 409);

  var saved;
  if (params.congregationId) {
    var existing = t.findById(params.congregationId);
    if (!existing) fail(ERR.NOT_FOUND, 'Congregation not found.', 404);
    if (existing.type === 'coordinator' && type !== 'coordinator') fail(ERR.VALIDATION, 'The coordinating congregation cannot change type.');
    var active = params.active === undefined ? toBool(existing.active) : toBool(params.active);
    if (existing.type === 'coordinator' && !active) fail(ERR.VALIDATION, 'The coordinating congregation cannot be deactivated.');
    saved = t.update(params.congregationId, { code: code, name: name, type: type, notes: notes, active: active ? 'TRUE' : 'FALSE', updatedAt: now });
    writeAudit(ctx.user.email, 'congregations.update', 'Congregations', saved.congregationId, 'Updated congregation ' + code, ctx.requestId, null);
  } else {
    if (type === 'coordinator' && t.read().some(function (c) { return c.type === 'coordinator'; })) fail(ERR.VALIDATION, 'Only one coordinating congregation is allowed.');
    saved = { congregationId: newId('cong'), code: code, name: name, type: type, active: 'TRUE', notes: notes, createdAt: now, updatedAt: now };
    t.append(saved);
    writeAudit(ctx.user.email, 'congregations.create', 'Congregations', saved.congregationId, 'Created congregation ' + code, ctx.requestId, null);
  }
  return publicCongregation(saved);
}


// ===================== 06_Items.js =====================
/**
 * 06_Items.js
 * Literature catalog. Quantities shown here always come from the ledger/balances (07_Inventory.js),
 * never from values supplied by the client.
 */

function publicItem(i, balance) {
  var b = balance || { physicalQty: 0, reservedQty: 0, availableQty: 0 };
  var threshold = i.minStock === '' || i.minStock === undefined || i.minStock === null
    ? toNum(getSetting('defaultLowStockThreshold'), 10) : toNum(i.minStock, 0);
  return {
    itemId: i.itemId, sku: i.sku || '', name: i.name || '', description: i.description || '', category: i.category || '',
    unit: i.unit || 'pcs', minStock: toNum(i.minStock, 0), lowStockThreshold: threshold, active: toBool(i.active),
    physicalQty: b.physicalQty, reservedQty: b.reservedQty, availableQty: b.availableQty,
    isLowStock: toBool(i.active) && b.physicalQty <= threshold,
    createdAt: i.createdAt || '', createdBy: i.createdBy || '', updatedAt: i.updatedAt || '', updatedBy: i.updatedBy || '',
    lastMovementAt: b.lastMovementAt || ''
  };
}

function itemsList(params, ctx) {
  requirePermission(ctx.user, 'items.view');
  var balances = getBalances();
  var rows = table(SHEETS.ITEMS).read()
    .filter(function (i) { return toBool(params.includeInactive) ? true : toBool(i.active); })
    .map(function (i) { return publicItem(i, balances[i.itemId]); })
    .filter(function (i) {
      if (params.category && i.category !== params.category) return false;
      if (toBool(params.lowStockOnly) && !i.isLowStock) return false;
      return textMatches(i, ['sku', 'name', 'description', 'category'], params.query);
    });
  rows = sortRows(rows, params.sortBy || 'name', params.sortDir || 'asc');
  var categories = uniq(table(SHEETS.ITEMS).read().map(function (i) { return i.category; }).filter(Boolean)).sort();
  var page = paginate(rows, params);
  page.categories = categories;
  return page;
}

function itemsGet(params, ctx) {
  requirePermission(ctx.user, 'items.view');
  var item = table(SHEETS.ITEMS).findById(params.itemId);
  if (!item) fail(ERR.NOT_FOUND, 'Literature item not found.', 404);
  var balances = getBalances();
  var out = publicItem(item, balances[item.itemId]);
  out.recentTransactions = itemLedger(item.itemId).slice(0, 10);
  return out;
}

function itemsHistory(params, ctx) {
  requirePermission(ctx.user, 'items.view');
  var item = table(SHEETS.ITEMS).findById(params.itemId);
  if (!item) fail(ERR.NOT_FOUND, 'Literature item not found.', 404);
  var rows = itemLedger(item.itemId).filter(function (t) {
    return (!params.from && !params.to) || inDateRange(t.timestamp, params.from, params.to);
  });
  return paginate(rows, params);
}

function validateItemInput(params, existingId) {
  var sku = requireString(params, 'sku', 'Item code / SKU', 40).toUpperCase();
  var name = requireString(params, 'name', 'Literature name', 160);
  var unit = optionalString(params, 'unit', 20) || 'pcs';
  var minStock = params.minStock === '' || params.minStock === undefined || params.minStock === null ? 0 : requireNonNegativeInt(params.minStock, 'Minimum stock');
  var duplicate = table(SHEETS.ITEMS).read().filter(function (i) { return String(i.sku).toUpperCase() === sku && i.itemId !== existingId; });
  if (duplicate.length) fail(ERR.CONFLICT, 'An item with code ' + sku + ' already exists.', 409);
  return {
    sku: sku, name: name, description: optionalString(params, 'description', 1000), category: optionalString(params, 'category', 60),
    unit: unit, minStock: minStock
  };
}

function itemsCreate(params, ctx) {
  requirePermission(ctx.user, 'items.manage');
  var input = validateItemInput(params, null);
  var now = nowIso();
  var item = {
    itemId: newId('itm'), sku: input.sku, name: input.name, description: input.description, category: input.category, unit: input.unit,
    minStock: input.minStock, active: 'TRUE', createdAt: now, createdBy: ctx.user.email, updatedAt: now, updatedBy: ctx.user.email
  };
  table(SHEETS.ITEMS).append(item);
  table(SHEETS.BALANCES).append({ itemId: item.itemId, physicalQty: 0, lastTxnId: '', updatedAt: now });

  var openingQty = params.openingQty === undefined || params.openingQty === '' || params.openingQty === null ? 0 : requireNonNegativeInt(params.openingQty, 'Opening quantity');
  if (openingQty > 0) {
    postTransactions([{ type: TXN_TYPES.OPENING_BALANCE, itemId: item.itemId, quantity: openingQty, refType: 'ITEM', refId: item.itemId, notes: 'Opening balance on item creation' }], ctx);
  }
  writeAudit(ctx.user.email, 'items.create', 'LiteratureItems', item.itemId, 'Created item ' + item.sku + ' - ' + item.name, ctx.requestId, { openingQty: openingQty });
  return publicItem(item, getBalances()[item.itemId]);
}

function itemsUpdate(params, ctx) {
  requirePermission(ctx.user, 'items.manage');
  var t = table(SHEETS.ITEMS);
  var existing = t.findById(params.itemId);
  if (!existing) fail(ERR.NOT_FOUND, 'Literature item not found.', 404);
  var input = validateItemInput(params, existing.itemId);
  var active = params.active === undefined ? toBool(existing.active) : toBool(params.active);
  var saved = t.update(existing.itemId, {
    sku: input.sku, name: input.name, description: input.description, category: input.category, unit: input.unit,
    minStock: input.minStock, active: active ? 'TRUE' : 'FALSE', updatedAt: nowIso(), updatedBy: ctx.user.email
  });
  writeAudit(ctx.user.email, 'items.update', 'LiteratureItems', saved.itemId, 'Updated item ' + saved.sku, ctx.requestId, null);
  return publicItem(saved, getBalances()[saved.itemId]);
}

/** Manual stock adjustment (count correction). Positive or negative; never below zero. */
function itemsAdjust(params, ctx) {
  requirePermission(ctx.user, 'items.manage');
  var item = table(SHEETS.ITEMS).findById(params.itemId);
  if (!item) fail(ERR.NOT_FOUND, 'Literature item not found.', 404);
  var qty = Number(params.quantity);
  if (!isFinite(qty) || qty === 0 || Math.floor(qty) !== qty) fail(ERR.VALIDATION, 'Adjustment quantity must be a non-zero whole number.');
  var reason = requireString(params, 'reason', 'Reason', 500);
  postTransactions([{ type: TXN_TYPES.ADJUSTMENT, itemId: item.itemId, quantity: qty, refType: 'ADJUSTMENT', refId: ctx.requestId, notes: reason }], ctx);
  writeAudit(ctx.user.email, 'items.adjust', 'LiteratureItems', item.itemId, 'Adjusted ' + item.sku + ' by ' + qty + ': ' + reason, ctx.requestId, { quantity: qty });
  return publicItem(item, getBalances()[item.itemId]);
}


// ===================== 07_Inventory.js =====================
/**
 * 07_Inventory.js
 * The inventory ledger (InventoryTransactions) is the source of truth for physical stock held by the
 * coordinating congregation. InventoryBalances is a materialized cache of SUM(quantity) per item and is
 * rebuilt by reconcile(). Reserved stock is derived from open approved requests, never stored.
 *
 *   physicalQty  = SUM(ledger.quantity) for the item
 *   reservedQty  = SUM(approvedQty - fulfilledQty) over requests in Approved / Partially Fulfilled   (if reserveOnApproval)
 *   availableQty = physicalQty - reservedQty
 */

/** Map itemId -> reserved quantity. */
function computeReservations() {
  var reserved = {};
  if (!getSettingBool('reserveOnApproval')) return reserved;
  var openStatuses = [STATUS.REQUEST.APPROVED, STATUS.REQUEST.PARTIALLY_FULFILLED];
  var openRequests = {};
  table(SHEETS.REQUESTS).read().forEach(function (r) { if (openStatuses.indexOf(r.status) !== -1) openRequests[r.requestId] = true; });
  table(SHEETS.REQUEST_ITEMS).read().forEach(function (ri) {
    if (!openRequests[ri.requestId]) return;
    var remaining = Math.max(0, toNum(ri.approvedQty) - toNum(ri.fulfilledQty));
    reserved[ri.itemId] = (reserved[ri.itemId] || 0) + remaining;
  });
  return reserved;
}

/** Map itemId -> { physicalQty, reservedQty, availableQty, lastMovementAt }. */
function getBalances() {
  var reserved = computeReservations();
  var out = {};
  table(SHEETS.BALANCES).read().forEach(function (b) {
    var physical = toNum(b.physicalQty);
    var res = reserved[b.itemId] || 0;
    out[b.itemId] = { physicalQty: physical, reservedQty: res, availableQty: physical - res, lastMovementAt: b.updatedAt || '' };
  });
  Object.keys(reserved).forEach(function (itemId) {
    if (!out[itemId]) out[itemId] = { physicalQty: 0, reservedQty: reserved[itemId], availableQty: -reserved[itemId], lastMovementAt: '' };
  });
  return out;
}

function sumLedgerByItem() {
  var sums = {};
  table(SHEETS.TRANSACTIONS).read().forEach(function (t) { sums[t.itemId] = (sums[t.itemId] || 0) + toNum(t.quantity); });
  return sums;
}

/**
 * Appends ledger rows and updates balances. MUST be called inside withLock().
 * Validates that no item balance goes negative before writing anything.
 * txns: [{ type, itemId, quantity, refType, refId, counterpartyCongregationId?, notes?, timestamp? }]
 */
function postTransactions(txns, ctx) {
  if (!txns || !txns.length) return [];
  var coordinator = getCoordinatorCongregation();
  var balancesTable = table(SHEETS.BALANCES);
  var current = {};
  balancesTable.read().forEach(function (b) { current[b.itemId] = toNum(b.physicalQty); });
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');

  // Validate first (all or nothing from the validation point of view).
  var projected = {};
  txns.forEach(function (t) {
    if (!items[t.itemId]) fail(ERR.NOT_FOUND, 'Literature item not found: ' + t.itemId, 404);
    var q = Number(t.quantity);
    if (!isFinite(q) || Math.floor(q) !== q || q === 0) fail(ERR.VALIDATION, 'Transaction quantity must be a non-zero whole number.');
    var before = projected[t.itemId] === undefined ? (current[t.itemId] || 0) : projected[t.itemId];
    var after = before + q;
    if (after < 0) fail(ERR.INSUFFICIENT_STOCK, 'Insufficient stock for ' + items[t.itemId].name + ' (' + items[t.itemId].sku + '): available ' + before + ', requested ' + Math.abs(q) + '.', 409);
    projected[t.itemId] = after;
  });

  var now = nowIso();
  var rows = txns.map(function (t) {
    return {
      txnId: newId('txn'), timestamp: t.timestamp || now, type: t.type, itemId: t.itemId, quantity: Number(t.quantity),
      holderCongregationId: coordinator.congregationId, refType: t.refType || '', refId: t.refId || '',
      counterpartyCongregationId: t.counterpartyCongregationId || '', actor: ctx.user ? ctx.user.email : 'system',
      notes: t.notes || '', requestKey: ctx.requestId || ''
    };
  });
  // 1) ledger (source of truth) 2) balances cache. If 2 fails, reconcile() repairs it from 1.
  table(SHEETS.TRANSACTIONS).append(rows);
  Object.keys(projected).forEach(function (itemId) {
    var lastTxn = rows.filter(function (r) { return r.itemId === itemId; }).pop();
    if (current[itemId] === undefined) balancesTable.append({ itemId: itemId, physicalQty: projected[itemId], lastTxnId: lastTxn.txnId, updatedAt: now });
    else balancesTable.update(itemId, { physicalQty: projected[itemId], lastTxnId: lastTxn.txnId, updatedAt: now });
  });
  return rows;
}

/** Ledger rows for one item, newest first, with running balance. */
function itemLedger(itemId) {
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var rows = table(SHEETS.TRANSACTIONS).read().filter(function (t) { return t.itemId === itemId; });
  rows = sortRows(rows, 'timestamp', 'asc');
  var running = 0;
  var out = rows.map(function (t) {
    running += toNum(t.quantity);
    var cp = congs[t.counterpartyCongregationId];
    return {
      txnId: t.txnId, timestamp: t.timestamp, type: t.type, quantity: toNum(t.quantity), balanceAfter: running,
      refType: t.refType, refId: t.refId, counterpartyCongregationId: t.counterpartyCongregationId || '',
      counterpartyName: cp ? cp.name : '', actor: t.actor, notes: t.notes || ''
    };
  });
  return out.reverse();
}

/** Ledger rows across all items with item details, filtered by date and type. */
function listTransactions(params) {
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var rows = table(SHEETS.TRANSACTIONS).read().filter(function (t) {
    if (params.type && t.type !== params.type) return false;
    if (params.itemId && t.itemId !== params.itemId) return false;
    if (params.congregationId && t.counterpartyCongregationId !== params.congregationId) return false;
    if ((params.from || params.to) && !inDateRange(t.timestamp, params.from, params.to)) return false;
    return true;
  }).map(function (t) {
    var i = items[t.itemId] || {};
    var cp = congs[t.counterpartyCongregationId];
    return {
      txnId: t.txnId, timestamp: t.timestamp, type: t.type, itemId: t.itemId, sku: i.sku || '', itemName: i.name || '',
      quantity: toNum(t.quantity), refType: t.refType, refId: t.refId, counterpartyCongregationId: t.counterpartyCongregationId || '',
      counterpartyName: cp ? cp.name : '', actor: t.actor, notes: t.notes || ''
    };
  });
  return rows.filter(function (r) { return textMatches(r, ['sku', 'itemName', 'refId', 'actor', 'notes', 'counterpartyName'], params.query); });
}

function transactionsList(params, ctx) {
  requirePermission(ctx.user, 'items.view');
  var rows = sortRows(listTransactions(params), params.sortBy || 'timestamp', params.sortDir || 'desc');
  return paginate(rows, params);
}

/**
 * Reconciliation. Rebuilds InventoryBalances from the ledger, recomputes request fulfilledQty from
 * distribution items, and finalizes/flags distributions left in Processing by an interrupted run.
 * Safe to run at any time; it only corrects derived data and never deletes ledger rows.
 */
function adminReconcile(params, ctx) {
  requirePermission(ctx.user, 'admin.reconcile');
  var apply = toBool(params.apply);
  var report = { balanceFixes: [], fulfilledFixes: [], processingDistributions: [], applied: apply };

  // 0) Distributions stuck in Processing: finalize if the ledger was written, otherwise mark Failed.
  //    Done first so that fulfilment (step 2) is computed against the corrected statuses.
  var distributions = indexBy(table(SHEETS.DISTRIBUTIONS).read(), 'distributionId');
  var ledgerByRef = groupBy(table(SHEETS.TRANSACTIONS).read().filter(function (t) { return t.refType === 'DISTRIBUTION'; }), 'refId');
  var effectiveStatus = {};
  var touchedRequests = {};
  Object.keys(distributions).forEach(function (id) {
    var d = distributions[id];
    effectiveStatus[id] = d.status;
    if (d.status !== STATUS.DISTRIBUTION.PROCESSING) return;
    var hasLedger = !!ledgerByRef[id];
    var next = hasLedger ? STATUS.DISTRIBUTION.RELEASED : STATUS.DISTRIBUTION.FAILED;
    effectiveStatus[id] = next;
    report.processingDistributions.push({ distributionId: id, reference: d.reference, ledgerWritten: hasLedger, action: hasLedger ? 'finalize' : 'mark failed' });
    if (apply) {
      table(SHEETS.DISTRIBUTIONS).update(id, { status: next, updatedAt: nowIso() });
      if (d.requestId) touchedRequests[d.requestId] = true;
    }
  });

  // 1) Balances vs ledger
  var sums = sumLedgerByItem();
  var balancesTable = table(SHEETS.BALANCES);
  var balanceRows = indexBy(balancesTable.read(), 'itemId');
  var itemIds = uniq(Object.keys(sums).concat(Object.keys(balanceRows)));
  itemIds.forEach(function (itemId) {
    var ledger = sums[itemId] || 0;
    var cached = balanceRows[itemId] ? toNum(balanceRows[itemId].physicalQty) : null;
    if (cached !== ledger) {
      report.balanceFixes.push({ itemId: itemId, cached: cached, ledger: ledger });
      if (apply) {
        if (balanceRows[itemId]) balancesTable.update(itemId, { physicalQty: ledger, updatedAt: nowIso() });
        else balancesTable.append({ itemId: itemId, physicalQty: ledger, lastTxnId: '', updatedAt: nowIso() });
      }
    }
  });

  // 2) Request item fulfilledQty vs distribution items (only distributions that reached Released/Received)
  var fulfilled = {};
  table(SHEETS.DISTRIBUTION_ITEMS).read().forEach(function (di) {
    var d = distributions[di.distributionId];
    if (!d || !di.requestItemId) return;
    if ([STATUS.DISTRIBUTION.RELEASED, STATUS.DISTRIBUTION.RECEIVED].indexOf(effectiveStatus[di.distributionId]) === -1) return;
    fulfilled[di.requestItemId] = (fulfilled[di.requestItemId] || 0) + toNum(di.quantity);
  });
  var requestItems = table(SHEETS.REQUEST_ITEMS);
  requestItems.read().forEach(function (ri) {
    var expected = fulfilled[ri.requestItemId] || 0;
    if (toNum(ri.fulfilledQty) !== expected) {
      report.fulfilledFixes.push({ requestItemId: ri.requestItemId, requestId: ri.requestId, cached: toNum(ri.fulfilledQty), computed: expected });
      if (apply) { requestItems.update(ri.requestItemId, { fulfilledQty: expected }); touchedRequests[ri.requestId] = true; }
    }
  });
  if (apply) Object.keys(touchedRequests).forEach(function (requestId) { refreshRequestStatus(requestId, ctx); });

  if (apply) {
    writeAudit(ctx.user.email, 'admin.reconcile', 'System', '', 'Reconciliation applied: ' + report.balanceFixes.length + ' balance fixes, ' +
      report.fulfilledFixes.length + ' fulfilment fixes, ' + report.processingDistributions.length + ' distributions', ctx.requestId, report);
  }
  return report;
}


// ===================== 08_Deliveries.js =====================
/**
 * 08_Deliveries.js
 * Incoming literature. Only CONFIRMED deliveries post to the ledger, and confirmation is idempotent:
 * if ledger rows with refType DELIVERY / refId already exist, no second posting happens.
 */

function deliveryItemsFor(deliveryId, items) {
  return table(SHEETS.DELIVERY_ITEMS).read().filter(function (di) { return di.deliveryId === deliveryId; }).map(function (di) {
    var i = items[di.itemId] || {};
    return { deliveryItemId: di.deliveryItemId, itemId: di.itemId, sku: i.sku || '', itemName: i.name || '', unit: i.unit || 'pcs', quantity: toNum(di.quantity) };
  });
}

function publicDelivery(d, congs, items, withItems) {
  var src = congs[d.sourceCongregationId];
  var out = {
    deliveryId: d.deliveryId, reference: d.reference, deliveryDate: toIsoDate(d.deliveryDate), sourceType: d.sourceType,
    sourceCongregationId: d.sourceCongregationId || '', sourceName: d.sourceType === 'congregation' && src ? src.name : (d.sourceName || ''),
    receivedBy: d.receivedBy || '', status: d.status, notes: d.notes || '', createdAt: d.createdAt, createdBy: d.createdBy,
    confirmedAt: d.confirmedAt || '', confirmedBy: d.confirmedBy || '', updatedAt: d.updatedAt || ''
  };
  var lines = deliveryItemsFor(d.deliveryId, items);
  out.itemCount = lines.length;
  out.totalQty = lines.reduce(function (s, l) { return s + l.quantity; }, 0);
  if (withItems) out.items = lines;
  return out;
}

function deliveriesList(params, ctx) {
  requirePermission(ctx.user, 'deliveries.view');
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var rows = table(SHEETS.DELIVERIES).read().filter(function (d) {
    if (params.status && d.status !== params.status) return false;
    if (params.sourceCongregationId && d.sourceCongregationId !== params.sourceCongregationId) return false;
    if ((params.from || params.to) && !inDateRange(d.deliveryDate, params.from, params.to)) return false;
    return true;
  }).map(function (d) { return publicDelivery(d, congs, items, false); })
    .filter(function (d) { return textMatches(d, ['reference', 'sourceName', 'receivedBy', 'notes', 'status'], params.query); });
  rows = sortRows(rows, params.sortBy || 'deliveryDate', params.sortDir || 'desc');
  return paginate(rows, params);
}

function deliveriesGet(params, ctx) {
  requirePermission(ctx.user, 'deliveries.view');
  var d = table(SHEETS.DELIVERIES).findById(params.deliveryId);
  if (!d) fail(ERR.NOT_FOUND, 'Delivery not found.', 404);
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var out = publicDelivery(d, congs, items, true);
  out.ledgerPosted = table(SHEETS.TRANSACTIONS).read().some(function (t) { return t.refType === 'DELIVERY' && t.refId === d.deliveryId; });
  return out;
}

function validateDeliveryLines(lines) {
  if (!Array.isArray(lines) || !lines.length) fail(ERR.VALIDATION, 'At least one literature item is required.');
  if (lines.length > 200) fail(ERR.VALIDATION, 'A delivery may contain at most 200 lines.');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var seen = {};
  return lines.map(function (l) {
    var itemId = requireString(l, 'itemId', 'Literature item');
    if (!items[itemId]) fail(ERR.NOT_FOUND, 'Literature item not found: ' + itemId, 404);
    if (!toBool(items[itemId].active)) fail(ERR.VALIDATION, items[itemId].name + ' is inactive.');
    if (seen[itemId]) fail(ERR.VALIDATION, 'Item ' + items[itemId].sku + ' appears more than once.');
    seen[itemId] = true;
    return { itemId: itemId, quantity: requirePositiveInt(l.quantity, 'Quantity for ' + items[itemId].sku) };
  });
}

function validateDeliveryHeader(params) {
  var sourceType = optionalString(params, 'sourceType') || 'supplier';
  if (['supplier', 'congregation'].indexOf(sourceType) === -1) fail(ERR.VALIDATION, 'Source type must be supplier or congregation.');
  var header = {
    deliveryDate: requireDate(params.deliveryDate, 'Delivery date'),
    sourceType: sourceType,
    sourceCongregationId: '',
    sourceName: '',
    receivedBy: requireString(params, 'receivedBy', 'Receiving person', 120),
    notes: optionalString(params, 'notes', 1000)
  };
  if (sourceType === 'congregation') {
    var c = requireCongregation(params.sourceCongregationId, 'Source congregation');
    header.sourceCongregationId = c.congregationId;
    header.sourceName = c.name;
  } else {
    header.sourceName = requireString(params, 'sourceName', 'Supplier name', 160);
  }
  return header;
}

/** Posts a Pending delivery to the ledger (idempotent) and marks it Confirmed. Call inside the lock. */
function confirmDeliveryRecord(d, ctx) {
  var now = nowIso();
  var alreadyPosted = table(SHEETS.TRANSACTIONS).read().some(function (t) { return t.refType === 'DELIVERY' && t.refId === d.deliveryId; });
  if (!alreadyPosted) {
    var lines = table(SHEETS.DELIVERY_ITEMS).read().filter(function (di) { return di.deliveryId === d.deliveryId; });
    postTransactions(lines.map(function (l) {
      return { type: TXN_TYPES.DELIVERY_IN, itemId: l.itemId, quantity: toNum(l.quantity), refType: 'DELIVERY', refId: d.deliveryId,
        counterpartyCongregationId: d.sourceCongregationId || '', notes: 'Delivery ' + d.reference + ' from ' + d.sourceName };
    }), ctx);
  }
  return table(SHEETS.DELIVERIES).update(d.deliveryId, { status: STATUS.DELIVERY.CONFIRMED, confirmedAt: now, confirmedBy: ctx.user.email, updatedAt: now, updatedBy: ctx.user.email });
}

function deliveriesCreate(params, ctx) {
  requirePermission(ctx.user, 'deliveries.manage');
  var header = validateDeliveryHeader(params);
  var lines = validateDeliveryLines(params.items);
  var now = nowIso();
  var d = {
    deliveryId: newId('dlv'), reference: nextReference(SHEETS.DELIVERIES, 'reference', getSetting('deliveryReferencePrefix') || 'DLV'),
    deliveryDate: header.deliveryDate, sourceType: header.sourceType, sourceCongregationId: header.sourceCongregationId, sourceName: header.sourceName,
    receivedBy: header.receivedBy, status: STATUS.DELIVERY.PENDING, notes: header.notes, createdAt: now, createdBy: ctx.user.email,
    confirmedAt: '', confirmedBy: '', updatedAt: now, updatedBy: ctx.user.email
  };
  table(SHEETS.DELIVERIES).append(d);
  table(SHEETS.DELIVERY_ITEMS).append(lines.map(function (l) { return { deliveryItemId: newId('dli'), deliveryId: d.deliveryId, itemId: l.itemId, quantity: l.quantity }; }));
  writeAudit(ctx.user.email, 'deliveries.create', 'Deliveries', d.deliveryId, 'Recorded delivery ' + d.reference + ' from ' + d.sourceName, ctx.requestId, { lines: lines.length });
  if (toBool(params.confirmNow)) {
    d = confirmDeliveryRecord(d, ctx);
    writeAudit(ctx.user.email, 'deliveries.confirm', 'Deliveries', d.deliveryId, 'Confirmed delivery ' + d.reference, ctx.requestId, null);
  }
  return deliveriesGet({ deliveryId: d.deliveryId }, ctx);
}

function deliveriesUpdate(params, ctx) {
  requirePermission(ctx.user, 'deliveries.manage');
  var t = table(SHEETS.DELIVERIES);
  var d = t.findById(params.deliveryId);
  if (!d) fail(ERR.NOT_FOUND, 'Delivery not found.', 404);
  if (d.status !== STATUS.DELIVERY.PENDING) fail(ERR.INVALID_TRANSITION, 'Only pending deliveries can be edited.', 409);
  var header = validateDeliveryHeader(params);
  var lines = validateDeliveryLines(params.items);
  var now = nowIso();
  t.update(d.deliveryId, {
    deliveryDate: header.deliveryDate, sourceType: header.sourceType, sourceCongregationId: header.sourceCongregationId, sourceName: header.sourceName,
    receivedBy: header.receivedBy, notes: header.notes, updatedAt: now, updatedBy: ctx.user.email
  });
  // Replace lines: existing lines are updated in place / new lines appended / removed lines zeroed (history preserved).
  var existing = table(SHEETS.DELIVERY_ITEMS).read().filter(function (di) { return di.deliveryId === d.deliveryId; });
  var byItem = indexBy(existing, 'itemId');
  var keep = {};
  var toAppend = [];
  lines.forEach(function (l) {
    keep[l.itemId] = true;
    if (byItem[l.itemId]) table(SHEETS.DELIVERY_ITEMS).update(byItem[l.itemId].deliveryItemId, { quantity: l.quantity });
    else toAppend.push({ deliveryItemId: newId('dli'), deliveryId: d.deliveryId, itemId: l.itemId, quantity: l.quantity });
  });
  existing.forEach(function (di) { if (!keep[di.itemId]) table(SHEETS.DELIVERY_ITEMS).update(di.deliveryItemId, { quantity: 0 }); });
  if (toAppend.length) table(SHEETS.DELIVERY_ITEMS).append(toAppend);
  writeAudit(ctx.user.email, 'deliveries.update', 'Deliveries', d.deliveryId, 'Edited pending delivery ' + d.reference, ctx.requestId, null);
  return deliveriesGet({ deliveryId: d.deliveryId }, ctx);
}

function deliveriesConfirm(params, ctx) {
  requirePermission(ctx.user, 'deliveries.manage');
  var d = table(SHEETS.DELIVERIES).findById(params.deliveryId);
  if (!d) fail(ERR.NOT_FOUND, 'Delivery not found.', 404);
  if (d.status === STATUS.DELIVERY.CONFIRMED) return deliveriesGet({ deliveryId: d.deliveryId }, ctx); // idempotent
  if (d.status !== STATUS.DELIVERY.PENDING) fail(ERR.INVALID_TRANSITION, 'Only pending deliveries can be confirmed.', 409);
  var lines = table(SHEETS.DELIVERY_ITEMS).read().filter(function (di) { return di.deliveryId === d.deliveryId && toNum(di.quantity) > 0; });
  if (!lines.length) fail(ERR.VALIDATION, 'This delivery has no items to confirm.');
  d = confirmDeliveryRecord(d, ctx);
  writeAudit(ctx.user.email, 'deliveries.confirm', 'Deliveries', d.deliveryId, 'Confirmed delivery ' + d.reference, ctx.requestId, null);
  return deliveriesGet({ deliveryId: d.deliveryId }, ctx);
}

function deliveriesCancel(params, ctx) {
  requirePermission(ctx.user, 'deliveries.manage');
  var t = table(SHEETS.DELIVERIES);
  var d = t.findById(params.deliveryId);
  if (!d) fail(ERR.NOT_FOUND, 'Delivery not found.', 404);
  if (d.status === STATUS.DELIVERY.CANCELLED) return deliveriesGet({ deliveryId: d.deliveryId }, ctx);
  if (d.status !== STATUS.DELIVERY.PENDING) fail(ERR.INVALID_TRANSITION, 'Only pending deliveries can be cancelled. Confirmed deliveries must be corrected with a stock adjustment.', 409);
  var reason = optionalString(params, 'reason', 500);
  var now = nowIso();
  t.update(d.deliveryId, { status: STATUS.DELIVERY.CANCELLED, notes: (d.notes ? d.notes + '\n' : '') + (reason ? 'Cancelled: ' + reason : 'Cancelled'), updatedAt: now, updatedBy: ctx.user.email });
  writeAudit(ctx.user.email, 'deliveries.cancel', 'Deliveries', d.deliveryId, 'Cancelled delivery ' + d.reference, ctx.requestId, { reason: reason });
  return deliveriesGet({ deliveryId: d.deliveryId }, ctx);
}


// ===================== 09_Requests.js =====================
/**
 * 09_Requests.js
 * Congregation literature requests.
 *
 * Status transitions
 *   Draft    -> Pending (submit) | Cancelled
 *   Pending  -> Approved (approve) | Rejected | Cancelled
 *   Approved -> Partially Fulfilled | Fulfilled (via distributions) | Cancelled (releases remaining reservation)
 *   Partially Fulfilled -> Fulfilled (via distributions) | Cancelled
 *   Fulfilled / Rejected / Cancelled are terminal.
 */

var REQUEST_TRANSITIONS = {
  'Draft': ['Pending', 'Cancelled'],
  'Pending': ['Approved', 'Rejected', 'Cancelled'],
  'Approved': ['Partially Fulfilled', 'Fulfilled', 'Cancelled'],
  'Partially Fulfilled': ['Fulfilled', 'Cancelled'],
  'Fulfilled': [], 'Rejected': [], 'Cancelled': []
};

function assertTransition(current, next) {
  var allowed = REQUEST_TRANSITIONS[current] || [];
  if (allowed.indexOf(next) === -1) fail(ERR.INVALID_TRANSITION, 'A request in status "' + current + '" cannot move to "' + next + '".', 409);
}

function requestLines(requestId, items) {
  return table(SHEETS.REQUEST_ITEMS).read().filter(function (ri) { return ri.requestId === requestId; }).map(function (ri) {
    var i = items[ri.itemId] || {};
    var approved = toNum(ri.approvedQty), fulfilled = toNum(ri.fulfilledQty);
    return {
      requestItemId: ri.requestItemId, itemId: ri.itemId, sku: i.sku || '', itemName: i.name || '', unit: i.unit || 'pcs',
      requestedQty: toNum(ri.requestedQty), approvedQty: approved, fulfilledQty: fulfilled, remainingQty: Math.max(0, approved - fulfilled)
    };
  });
}

function publicRequest(r, congs, items, withItems) {
  var c = congs[r.congregationId];
  var lines = requestLines(r.requestId, items);
  var out = {
    requestId: r.requestId, requestNumber: r.requestNumber, congregationId: r.congregationId, congregationName: c ? c.name : '',
    congregationCode: c ? c.code : '', requestDate: toIsoDate(r.requestDate), requestedBy: r.requestedBy || '', approvedBy: r.approvedBy || '',
    status: r.status, notes: r.notes || '', decisionNotes: r.decisionNotes || '', createdAt: r.createdAt, createdBy: r.createdBy,
    submittedAt: r.submittedAt || '', decidedAt: r.decidedAt || '', updatedAt: r.updatedAt || '', updatedBy: r.updatedBy || '',
    itemCount: lines.length,
    requestedTotal: lines.reduce(function (s, l) { return s + l.requestedQty; }, 0),
    approvedTotal: lines.reduce(function (s, l) { return s + l.approvedQty; }, 0),
    fulfilledTotal: lines.reduce(function (s, l) { return s + l.fulfilledQty; }, 0)
  };
  out.remainingTotal = Math.max(0, out.approvedTotal - out.fulfilledTotal);
  if (withItems) out.items = lines;
  return out;
}

function requestsList(params, ctx) {
  var scope = requireScope(ctx.user, 'requests.view.all', 'requests.view.own');
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var rows = table(SHEETS.REQUESTS).read().filter(function (r) {
    if (!scope.all && r.congregationId !== scope.congregationId) return false;
    if (params.congregationId && r.congregationId !== params.congregationId) return false;
    if (params.status && r.status !== params.status) return false;
    if (Array.isArray(params.statuses) && params.statuses.length && params.statuses.indexOf(r.status) === -1) return false;
    if ((params.from || params.to) && !inDateRange(r.requestDate, params.from, params.to)) return false;
    return true;
  }).map(function (r) { return publicRequest(r, congs, items, false); })
    .filter(function (r) { return textMatches(r, ['requestNumber', 'congregationName', 'requestedBy', 'approvedBy', 'notes', 'status'], params.query); });
  rows = sortRows(rows, params.sortBy || 'requestDate', params.sortDir || 'desc');
  return paginate(rows, params);
}

function loadRequestForUser(requestId, ctx) {
  var scope = requireScope(ctx.user, 'requests.view.all', 'requests.view.own');
  var r = table(SHEETS.REQUESTS).findById(requestId);
  if (!r) fail(ERR.NOT_FOUND, 'Request not found.', 404);
  assertScopeCongregation(scope, r.congregationId);
  return r;
}

function requestsGet(params, ctx) {
  var r = loadRequestForUser(params.requestId, ctx);
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var out = publicRequest(r, congs, items, true);
  if (hasPermission(ctx.user, 'requests.decide')) {
    var balances = getBalances();
    out.items.forEach(function (l) {
      var b = balances[l.itemId] || { physicalQty: 0, reservedQty: 0, availableQty: 0 };
      l.physicalQty = b.physicalQty; l.reservedQty = b.reservedQty; l.availableQty = b.availableQty;
    });
  }
  out.distributions = table(SHEETS.DISTRIBUTIONS).read().filter(function (d) { return d.requestId === r.requestId; }).map(function (d) {
    return { distributionId: d.distributionId, reference: d.reference, status: d.status, createdAt: d.createdAt, releasedBy: d.releasedBy || '' };
  });
  return out;
}

function validateRequestLines(lines) {
  if (!Array.isArray(lines) || !lines.length) fail(ERR.VALIDATION, 'At least one literature item is required.');
  if (lines.length > 200) fail(ERR.VALIDATION, 'A request may contain at most 200 lines.');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var seen = {};
  return lines.map(function (l) {
    var itemId = requireString(l, 'itemId', 'Literature item');
    if (!items[itemId]) fail(ERR.NOT_FOUND, 'Literature item not found: ' + itemId, 404);
    if (!toBool(items[itemId].active)) fail(ERR.VALIDATION, items[itemId].name + ' is inactive.');
    if (seen[itemId]) fail(ERR.VALIDATION, 'Item ' + items[itemId].sku + ' appears more than once.');
    seen[itemId] = true;
    return { itemId: itemId, requestedQty: requirePositiveInt(l.requestedQty !== undefined ? l.requestedQty : l.quantity, 'Quantity for ' + items[itemId].sku) };
  });
}

function resolveRequestCongregation(params, ctx) {
  if (ctx.user.role === ROLES.CONGREGATION_USER) {
    if (!ctx.user.congregationId) fail(ERR.FORBIDDEN, 'Your account is not linked to a congregation. Contact an administrator.', 403);
    return requireCongregation(ctx.user.congregationId, 'Your congregation');
  }
  return requireCongregation(params.congregationId, 'Requesting congregation');
}

function requestsCreate(params, ctx) {
  requirePermission(ctx.user, 'requests.create');
  var cong = resolveRequestCongregation(params, ctx);
  var coordinator = getCoordinatorCongregation();
  if (cong.congregationId === coordinator.congregationId) fail(ERR.VALIDATION, 'The coordinating congregation does not request literature from itself.');
  var lines = validateRequestLines(params.items);
  var now = nowIso();
  var submit = toBool(params.submit);
  var r = {
    requestId: newId('req'), requestNumber: nextReference(SHEETS.REQUESTS, 'requestNumber', getSetting('requestNumberPrefix') || 'REQ'),
    congregationId: cong.congregationId, requestDate: params.requestDate ? requireDate(params.requestDate, 'Request date') : toIsoDate(new Date()),
    requestedBy: optionalString(params, 'requestedBy', 120) || ctx.user.name || ctx.user.email, approvedBy: '',
    status: submit ? STATUS.REQUEST.PENDING : STATUS.REQUEST.DRAFT, notes: optionalString(params, 'notes', 1000), decisionNotes: '',
    createdAt: now, createdBy: ctx.user.email, submittedAt: submit ? now : '', decidedAt: '', updatedAt: now, updatedBy: ctx.user.email
  };
  table(SHEETS.REQUESTS).append(r);
  table(SHEETS.REQUEST_ITEMS).append(lines.map(function (l) {
    return { requestItemId: newId('rqi'), requestId: r.requestId, itemId: l.itemId, requestedQty: l.requestedQty, approvedQty: 0, fulfilledQty: 0 };
  }));
  writeAudit(ctx.user.email, 'requests.create', 'Requests', r.requestId, (submit ? 'Submitted' : 'Drafted') + ' request ' + r.requestNumber + ' for ' + cong.name, ctx.requestId, { lines: lines.length });
  return requestsGet({ requestId: r.requestId }, ctx);
}

function assertCanEditRequest(r, ctx) {
  if (hasPermission(ctx.user, 'requests.decide')) return;
  if (ctx.user.role === ROLES.CONGREGATION_USER && r.congregationId === ctx.user.congregationId) return;
  fail(ERR.FORBIDDEN, 'You may only edit requests for your own congregation.', 403);
}

function requestsUpdate(params, ctx) {
  requirePermission(ctx.user, 'requests.create');
  var t = table(SHEETS.REQUESTS);
  var r = t.findById(params.requestId);
  if (!r) fail(ERR.NOT_FOUND, 'Request not found.', 404);
  assertCanEditRequest(r, ctx);
  if ([STATUS.REQUEST.DRAFT, STATUS.REQUEST.PENDING].indexOf(r.status) === -1) fail(ERR.INVALID_TRANSITION, 'Only draft or pending requests can be edited.', 409);
  var lines = validateRequestLines(params.items);
  var now = nowIso();
  t.update(r.requestId, {
    requestDate: params.requestDate ? requireDate(params.requestDate, 'Request date') : r.requestDate,
    requestedBy: optionalString(params, 'requestedBy', 120) || r.requestedBy, notes: optionalString(params, 'notes', 1000), updatedAt: now, updatedBy: ctx.user.email
  });
  var ri = table(SHEETS.REQUEST_ITEMS);
  var existing = ri.read().filter(function (x) { return x.requestId === r.requestId; });
  var byItem = indexBy(existing, 'itemId');
  var keep = {}, toAppend = [];
  lines.forEach(function (l) {
    keep[l.itemId] = true;
    if (byItem[l.itemId]) ri.update(byItem[l.itemId].requestItemId, { requestedQty: l.requestedQty });
    else toAppend.push({ requestItemId: newId('rqi'), requestId: r.requestId, itemId: l.itemId, requestedQty: l.requestedQty, approvedQty: 0, fulfilledQty: 0 });
  });
  existing.forEach(function (x) { if (!keep[x.itemId]) ri.update(x.requestItemId, { requestedQty: 0 }); });
  if (toAppend.length) ri.append(toAppend);
  writeAudit(ctx.user.email, 'requests.update', 'Requests', r.requestId, 'Edited request ' + r.requestNumber, ctx.requestId, null);
  return requestsGet({ requestId: r.requestId }, ctx);
}

function requestsSubmit(params, ctx) {
  requirePermission(ctx.user, 'requests.create');
  var t = table(SHEETS.REQUESTS);
  var r = t.findById(params.requestId);
  if (!r) fail(ERR.NOT_FOUND, 'Request not found.', 404);
  assertCanEditRequest(r, ctx);
  if (r.status === STATUS.REQUEST.PENDING) return requestsGet({ requestId: r.requestId }, ctx);
  assertTransition(r.status, STATUS.REQUEST.PENDING);
  var hasLines = table(SHEETS.REQUEST_ITEMS).read().some(function (x) { return x.requestId === r.requestId && toNum(x.requestedQty) > 0; });
  if (!hasLines) fail(ERR.VALIDATION, 'Add at least one item before submitting.');
  var now = nowIso();
  t.update(r.requestId, { status: STATUS.REQUEST.PENDING, submittedAt: now, updatedAt: now, updatedBy: ctx.user.email });
  writeAudit(ctx.user.email, 'requests.submit', 'Requests', r.requestId, 'Submitted request ' + r.requestNumber, ctx.requestId, null);
  return requestsGet({ requestId: r.requestId }, ctx);
}

/**
 * Approve with per-line approved quantities (defaults to requested). When reserveOnApproval is on,
 * the approved quantity may not exceed currently available stock, so a reservation is always fulfillable.
 */
function requestsApprove(params, ctx) {
  requirePermission(ctx.user, 'requests.decide');
  var t = table(SHEETS.REQUESTS);
  var r = t.findById(params.requestId);
  if (!r) fail(ERR.NOT_FOUND, 'Request not found.', 404);
  assertTransition(r.status, STATUS.REQUEST.APPROVED);
  var ri = table(SHEETS.REQUEST_ITEMS);
  var lines = ri.read().filter(function (x) { return x.requestId === r.requestId && toNum(x.requestedQty) > 0; });
  if (!lines.length) fail(ERR.VALIDATION, 'This request has no items.');
  var overrides = {};
  (Array.isArray(params.items) ? params.items : []).forEach(function (o) { if (o && o.requestItemId !== undefined) overrides[o.requestItemId] = o.approvedQty; });
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var balances = getBalances();
  var reserve = getSettingBool('reserveOnApproval');
  var total = 0;
  var decided = lines.map(function (l) {
    var requested = toNum(l.requestedQty);
    var approved = overrides[l.requestItemId] === undefined ? requested : requireNonNegativeInt(overrides[l.requestItemId], 'Approved quantity for ' + (items[l.itemId] || {}).sku);
    if (approved > requested) fail(ERR.VALIDATION, 'Approved quantity cannot exceed the requested quantity for ' + (items[l.itemId] || {}).sku + '.');
    if (reserve && approved > 0) {
      var b = balances[l.itemId] || { availableQty: 0 };
      if (approved > b.availableQty) fail(ERR.INSUFFICIENT_STOCK, 'Only ' + b.availableQty + ' available for ' + (items[l.itemId] || {}).name + '; reduce the approved quantity.', 409);
    }
    total += approved;
    return { requestItemId: l.requestItemId, approvedQty: approved };
  });
  if (total <= 0) fail(ERR.VALIDATION, 'Approve at least one unit, or reject the request instead.');
  decided.forEach(function (d) { ri.update(d.requestItemId, { approvedQty: d.approvedQty, fulfilledQty: 0 }); });
  var now = nowIso();
  t.update(r.requestId, { status: STATUS.REQUEST.APPROVED, approvedBy: ctx.user.name || ctx.user.email, decidedAt: now, decisionNotes: optionalString(params, 'decisionNotes', 1000), updatedAt: now, updatedBy: ctx.user.email });
  writeAudit(ctx.user.email, 'requests.approve', 'Requests', r.requestId, 'Approved request ' + r.requestNumber + ' (' + total + ' units)', ctx.requestId, { lines: decided });
  return requestsGet({ requestId: r.requestId }, ctx);
}

function requestsReject(params, ctx) {
  requirePermission(ctx.user, 'requests.decide');
  var t = table(SHEETS.REQUESTS);
  var r = t.findById(params.requestId);
  if (!r) fail(ERR.NOT_FOUND, 'Request not found.', 404);
  if (r.status === STATUS.REQUEST.REJECTED) return requestsGet({ requestId: r.requestId }, ctx);
  assertTransition(r.status, STATUS.REQUEST.REJECTED);
  var now = nowIso();
  t.update(r.requestId, { status: STATUS.REQUEST.REJECTED, approvedBy: ctx.user.name || ctx.user.email, decidedAt: now, decisionNotes: requireString(params, 'decisionNotes', 'Reason', 1000), updatedAt: now, updatedBy: ctx.user.email });
  writeAudit(ctx.user.email, 'requests.reject', 'Requests', r.requestId, 'Rejected request ' + r.requestNumber, ctx.requestId, null);
  return requestsGet({ requestId: r.requestId }, ctx);
}

function requestsCancel(params, ctx) {
  var t = table(SHEETS.REQUESTS);
  var r = t.findById(params.requestId);
  if (!r) fail(ERR.NOT_FOUND, 'Request not found.', 404);
  if (hasPermission(ctx.user, 'requests.decide')) {
    // ok: any cancellable status
  } else if (ctx.user.role === ROLES.CONGREGATION_USER && r.congregationId === ctx.user.congregationId) {
    if ([STATUS.REQUEST.DRAFT, STATUS.REQUEST.PENDING].indexOf(r.status) === -1) fail(ERR.FORBIDDEN, 'Approved requests can only be cancelled by the inventory team.', 403);
  } else {
    fail(ERR.FORBIDDEN, 'You do not have permission to cancel this request.', 403);
  }
  if (r.status === STATUS.REQUEST.CANCELLED) return requestsGet({ requestId: r.requestId }, ctx);
  assertTransition(r.status, STATUS.REQUEST.CANCELLED);
  var now = nowIso();
  var reason = optionalString(params, 'reason', 500);
  // Reservation release is automatic: reservations are computed only from Approved / Partially Fulfilled requests.
  t.update(r.requestId, { status: STATUS.REQUEST.CANCELLED, decisionNotes: reason ? 'Cancelled: ' + reason : (r.decisionNotes || 'Cancelled'), updatedAt: now, updatedBy: ctx.user.email });
  writeAudit(ctx.user.email, 'requests.cancel', 'Requests', r.requestId, 'Cancelled request ' + r.requestNumber, ctx.requestId, { reason: reason, previousStatus: r.status });
  return requestsGet({ requestId: r.requestId }, ctx);
}

/** Recomputes status from fulfilled vs approved quantities after a distribution (inside the lock). */
function refreshRequestStatus(requestId, ctx) {
  var t = table(SHEETS.REQUESTS);
  var r = t.findById(requestId);
  if (!r) return null;
  if ([STATUS.REQUEST.APPROVED, STATUS.REQUEST.PARTIALLY_FULFILLED, STATUS.REQUEST.FULFILLED].indexOf(r.status) === -1) return r;
  var lines = table(SHEETS.REQUEST_ITEMS).read().filter(function (x) { return x.requestId === requestId; });
  var approved = 0, fulfilled = 0;
  lines.forEach(function (l) { approved += toNum(l.approvedQty); fulfilled += Math.min(toNum(l.approvedQty), toNum(l.fulfilledQty)); });
  var next = fulfilled <= 0 ? STATUS.REQUEST.APPROVED : (fulfilled >= approved ? STATUS.REQUEST.FULFILLED : STATUS.REQUEST.PARTIALLY_FULFILLED);
  if (next !== r.status) r = t.update(requestId, { status: next, updatedAt: nowIso(), updatedBy: ctx.user ? ctx.user.email : 'system' });
  return r;
}


// ===================== 10_Distributions.js =====================
/**
 * 10_Distributions.js
 * Releasing stock to a congregation.
 *
 * Write order inside the lock (so an interruption is detectable and repairable by adminReconcile):
 *   1. Distribution header (status Processing) + DistributionItems
 *   2. Ledger rows (DISTRIBUTION_OUT, refId = distributionId) + balances
 *   3. RequestItems.fulfilledQty + request status
 *   4. Distribution status -> Released
 * Google Sheets has no transactions. Steps are ordered so that the ledger is never written twice for the
 * same distribution and so partial writes can be finalized or flagged by the reconcile routine.
 */

function distributionLines(distributionId, items) {
  return table(SHEETS.DISTRIBUTION_ITEMS).read().filter(function (x) { return x.distributionId === distributionId; }).map(function (x) {
    var i = items[x.itemId] || {};
    return { distributionItemId: x.distributionItemId, itemId: x.itemId, sku: i.sku || '', itemName: i.name || '', unit: i.unit || 'pcs', quantity: toNum(x.quantity), requestItemId: x.requestItemId || '' };
  });
}

function publicDistribution(d, congs, items, requests, withItems) {
  var c = congs[d.destinationCongregationId];
  var r = requests ? requests[d.requestId] : null;
  var lines = distributionLines(d.distributionId, items);
  var out = {
    distributionId: d.distributionId, reference: d.reference, requestId: d.requestId || '', requestNumber: r ? r.requestNumber : '',
    destinationCongregationId: d.destinationCongregationId, destinationName: c ? c.name : '', destinationCode: c ? c.code : '',
    releasedBy: d.releasedBy || '', receivedBy: d.receivedBy || '', status: d.status, notes: d.notes || '',
    createdAt: d.createdAt, createdBy: d.createdBy, receivedAt: d.receivedAt || '', receivedConfirmedBy: d.receivedConfirmedBy || '', updatedAt: d.updatedAt || '',
    itemCount: lines.length, totalQty: lines.reduce(function (s, l) { return s + l.quantity; }, 0)
  };
  if (withItems) out.items = lines;
  return out;
}

function distributionsList(params, ctx) {
  var scope = requireScope(ctx.user, 'distributions.view.all', 'distributions.view.own');
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var requests = indexBy(table(SHEETS.REQUESTS).read(), 'requestId');
  var rows = table(SHEETS.DISTRIBUTIONS).read().filter(function (d) {
    if (!scope.all && d.destinationCongregationId !== scope.congregationId) return false;
    if (params.congregationId && d.destinationCongregationId !== params.congregationId) return false;
    if (params.status && d.status !== params.status) return false;
    if (params.requestId && d.requestId !== params.requestId) return false;
    if ((params.from || params.to) && !inDateRange(d.createdAt, params.from, params.to)) return false;
    return true;
  }).map(function (d) { return publicDistribution(d, congs, items, requests, false); })
    .filter(function (d) { return textMatches(d, ['reference', 'requestNumber', 'destinationName', 'releasedBy', 'receivedBy', 'notes', 'status'], params.query); });
  rows = sortRows(rows, params.sortBy || 'createdAt', params.sortDir || 'desc');
  return paginate(rows, params);
}

function distributionsGet(params, ctx) {
  var scope = requireScope(ctx.user, 'distributions.view.all', 'distributions.view.own');
  var d = table(SHEETS.DISTRIBUTIONS).findById(params.distributionId);
  if (!d) fail(ERR.NOT_FOUND, 'Distribution not found.', 404);
  assertScopeCongregation(scope, d.destinationCongregationId);
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var requests = indexBy(table(SHEETS.REQUESTS).read(), 'requestId');
  var out = publicDistribution(d, congs, items, requests, true);
  var coordinator = getCoordinatorCongregation();
  out.receipt = {
    appName: CONFIG.APP_NAME, issuedBy: coordinator.name, issuedByCode: coordinator.code,
    reference: out.reference, requestNumber: out.requestNumber, destination: out.destinationName, releasedBy: out.releasedBy,
    receivedBy: out.receivedBy, releasedAt: out.createdAt, status: out.status, notes: out.notes, items: out.items, totalQty: out.totalQty
  };
  return out;
}

function distributionsCreate(params, ctx) {
  requirePermission(ctx.user, 'distributions.create');
  var lines = params.items;
  if (!Array.isArray(lines) || !lines.length) fail(ERR.VALIDATION, 'At least one literature item is required.');
  if (lines.length > 200) fail(ERR.VALIDATION, 'A distribution may contain at most 200 lines.');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var coordinator = getCoordinatorCongregation();
  var releasedBy = optionalString(params, 'releasedBy', 120) || ctx.user.name || ctx.user.email;
  var receivedBy = optionalString(params, 'receivedBy', 120);
  var notes = optionalString(params, 'notes', 1000);

  var request = null, destination = null, requestLinesByItem = {};
  if (isNonEmptyString(params.requestId)) {
    request = table(SHEETS.REQUESTS).findById(params.requestId);
    if (!request) fail(ERR.NOT_FOUND, 'Request not found.', 404);
    if ([STATUS.REQUEST.APPROVED, STATUS.REQUEST.PARTIALLY_FULFILLED].indexOf(request.status) === -1) {
      fail(ERR.INVALID_TRANSITION, 'Only approved or partially fulfilled requests can be distributed. This request is "' + request.status + '".', 409);
    }
    destination = requireCongregation(request.congregationId, 'Destination congregation');
    table(SHEETS.REQUEST_ITEMS).read().forEach(function (ri) { if (ri.requestId === request.requestId) requestLinesByItem[ri.itemId] = ri; });
  } else {
    if (!getSettingBool('allowAdHocDistribution')) fail(ERR.VALIDATION, 'Distributions must be made against an approved request.');
    destination = requireCongregation(params.destinationCongregationId, 'Destination congregation');
  }
  if (destination.congregationId === coordinator.congregationId) fail(ERR.VALIDATION, 'Stock cannot be distributed to the coordinating congregation itself.');

  var balances = getBalances();
  var seen = {};
  var validated = lines.map(function (l) {
    var itemId = requireString(l, 'itemId', 'Literature item');
    var item = items[itemId];
    if (!item) fail(ERR.NOT_FOUND, 'Literature item not found: ' + itemId, 404);
    if (seen[itemId]) fail(ERR.VALIDATION, 'Item ' + item.sku + ' appears more than once.');
    seen[itemId] = true;
    var qty = requirePositiveInt(l.quantity, 'Quantity for ' + item.sku);
    var b = balances[itemId] || { physicalQty: 0, reservedQty: 0, availableQty: 0 };
    var requestItemId = '';
    if (request) {
      var ri = requestLinesByItem[itemId];
      if (!ri) fail(ERR.VALIDATION, item.sku + ' is not part of request ' + request.requestNumber + '.');
      var remaining = Math.max(0, toNum(ri.approvedQty) - toNum(ri.fulfilledQty));
      if (qty > remaining) fail(ERR.VALIDATION, 'Only ' + remaining + ' remaining to fulfil for ' + item.sku + ' on ' + request.requestNumber + '.');
      requestItemId = ri.requestItemId;
      // This request's own reservation is usable, other reservations are not.
      var usable = b.physicalQty - (b.reservedQty - Math.min(b.reservedQty, remaining));
      if (qty > usable) fail(ERR.INSUFFICIENT_STOCK, 'Insufficient stock for ' + item.name + ': ' + usable + ' usable, ' + qty + ' requested.', 409);
    } else if (qty > b.availableQty) {
      fail(ERR.INSUFFICIENT_STOCK, 'Insufficient available stock for ' + item.name + ': ' + b.availableQty + ' available, ' + qty + ' requested.', 409);
    }
    if (qty > b.physicalQty) fail(ERR.INSUFFICIENT_STOCK, 'Insufficient physical stock for ' + item.name + '.', 409);
    return { itemId: itemId, quantity: qty, requestItemId: requestItemId };
  });

  var now = nowIso();
  var d = {
    distributionId: newId('dst'), reference: nextReference(SHEETS.DISTRIBUTIONS, 'reference', getSetting('distributionReferencePrefix') || 'DST'),
    requestId: request ? request.requestId : '', destinationCongregationId: destination.congregationId, releasedBy: releasedBy, receivedBy: receivedBy,
    status: STATUS.DISTRIBUTION.PROCESSING, notes: notes, createdAt: now, createdBy: ctx.user.email, receivedAt: '', receivedConfirmedBy: '', updatedAt: now
  };
  // 1) header + lines
  table(SHEETS.DISTRIBUTIONS).append(d);
  table(SHEETS.DISTRIBUTION_ITEMS).append(validated.map(function (v) {
    return { distributionItemId: newId('dsi'), distributionId: d.distributionId, itemId: v.itemId, quantity: v.quantity, requestItemId: v.requestItemId };
  }));
  // 2) ledger
  postTransactions(validated.map(function (v) {
    return { type: TXN_TYPES.DISTRIBUTION_OUT, itemId: v.itemId, quantity: -v.quantity, refType: 'DISTRIBUTION', refId: d.distributionId,
      counterpartyCongregationId: destination.congregationId, notes: 'Distribution ' + d.reference + ' to ' + destination.name };
  }), ctx);
  // 3) request fulfilment
  if (request) {
    var ri = table(SHEETS.REQUEST_ITEMS);
    validated.forEach(function (v) {
      var line = ri.findById(v.requestItemId);
      ri.update(v.requestItemId, { fulfilledQty: toNum(line.fulfilledQty) + v.quantity });
    });
    refreshRequestStatus(request.requestId, ctx);
  }
  // 4) finalize
  table(SHEETS.DISTRIBUTIONS).update(d.distributionId, { status: STATUS.DISTRIBUTION.RELEASED, updatedAt: nowIso() });
  writeAudit(ctx.user.email, 'distributions.create', 'Distributions', d.distributionId,
    'Released ' + d.reference + ' to ' + destination.name + (request ? ' for ' + request.requestNumber : ''), ctx.requestId, { lines: validated });
  return distributionsGet({ distributionId: d.distributionId }, ctx);
}

function distributionsConfirmReceipt(params, ctx) {
  requirePermission(ctx.user, 'distributions.confirm');
  var t = table(SHEETS.DISTRIBUTIONS);
  var d = t.findById(params.distributionId);
  if (!d) fail(ERR.NOT_FOUND, 'Distribution not found.', 404);
  if (ctx.user.role === ROLES.CONGREGATION_USER && d.destinationCongregationId !== ctx.user.congregationId) {
    fail(ERR.FORBIDDEN, 'You may only confirm receipt for your own congregation.', 403);
  }
  if (d.status === STATUS.DISTRIBUTION.RECEIVED) return distributionsGet({ distributionId: d.distributionId }, ctx);
  if (d.status !== STATUS.DISTRIBUTION.RELEASED) fail(ERR.INVALID_TRANSITION, 'Only released distributions can be confirmed as received.', 409);
  var now = nowIso();
  t.update(d.distributionId, {
    status: STATUS.DISTRIBUTION.RECEIVED, receivedAt: now, receivedConfirmedBy: ctx.user.email,
    receivedBy: optionalString(params, 'receivedBy', 120) || d.receivedBy || ctx.user.name || ctx.user.email, updatedAt: now
  });
  writeAudit(ctx.user.email, 'distributions.confirmReceipt', 'Distributions', d.distributionId, 'Confirmed receipt of ' + d.reference, ctx.requestId, null);
  return distributionsGet({ distributionId: d.distributionId }, ctx);
}


// ===================== 11_Stock.js =====================
/**
 * 11_Stock.js
 * Congregation stock overview.
 *
 * For the coordinator (East): physical / reserved / available per item plus movements in the period.
 * For member congregations: quantities CONFIRMED RECEIVED from East (cumulative), quantities released but
 * not yet confirmed (in transit), outstanding approved-but-unfulfilled requests, and history.
 * A member congregation's "received" total is NOT physical stock held by East and is never added to it.
 */

function stockOverview(params, ctx) {
  var scope = requireScope(ctx.user, 'stock.view.all', 'stock.view.own');
  var congregationId = params.congregationId || (scope.all ? getCoordinatorCongregation().congregationId : scope.congregationId);
  assertScopeCongregation(scope, congregationId);
  var cong = table(SHEETS.CONGREGATIONS).findById(congregationId);
  if (!cong) fail(ERR.NOT_FOUND, 'Congregation not found.', 404);
  var coordinator = getCoordinatorCongregation();
  var isCoordinator = cong.congregationId === coordinator.congregationId;
  var from = params.from ? toIsoDate(params.from) : '', to = params.to ? toIsoDate(params.to) : '';
  var items = table(SHEETS.ITEMS).read();
  var itemMap = indexBy(items, 'itemId');
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');

  var out = { congregation: publicCongregation(cong), isCoordinator: isCoordinator, from: from, to: to, items: [], requests: [], distributions: [], totals: {} };

  if (isCoordinator) {
    var balances = getBalances();
    var txns = table(SHEETS.TRANSACTIONS).read().filter(function (t) { return (!from && !to) || inDateRange(t.timestamp, from, to); });
    var inBy = {}, outBy = {}, adjBy = {};
    txns.forEach(function (t) {
      var q = toNum(t.quantity);
      if (t.type === TXN_TYPES.DISTRIBUTION_OUT) outBy[t.itemId] = (outBy[t.itemId] || 0) + Math.abs(q);
      else if (t.type === TXN_TYPES.DELIVERY_IN || t.type === TXN_TYPES.OPENING_BALANCE) inBy[t.itemId] = (inBy[t.itemId] || 0) + q;
      else adjBy[t.itemId] = (adjBy[t.itemId] || 0) + q;
    });
    out.items = items.filter(function (i) { return toBool(i.active); }).map(function (i) {
      var b = balances[i.itemId] || { physicalQty: 0, reservedQty: 0, availableQty: 0 };
      return { itemId: i.itemId, sku: i.sku, name: i.name, unit: i.unit || 'pcs', physicalQty: b.physicalQty, reservedQty: b.reservedQty, availableQty: b.availableQty,
        receivedQty: inBy[i.itemId] || 0, releasedQty: outBy[i.itemId] || 0, adjustedQty: adjBy[i.itemId] || 0 };
    });
    out.totals = {
      physicalQty: out.items.reduce(function (s, i) { return s + i.physicalQty; }, 0),
      reservedQty: out.items.reduce(function (s, i) { return s + i.reservedQty; }, 0),
      availableQty: out.items.reduce(function (s, i) { return s + i.availableQty; }, 0),
      receivedQty: out.items.reduce(function (s, i) { return s + i.receivedQty; }, 0),
      releasedQty: out.items.reduce(function (s, i) { return s + i.releasedQty; }, 0)
    };
  } else {
    var dists = table(SHEETS.DISTRIBUTIONS).read().filter(function (d) { return d.destinationCongregationId === cong.congregationId && d.status !== STATUS.DISTRIBUTION.FAILED && d.status !== STATUS.DISTRIBUTION.PROCESSING; });
    var distMap = indexBy(dists, 'distributionId');
    var receivedBy = {}, inTransitBy = {}, periodReceivedBy = {};
    table(SHEETS.DISTRIBUTION_ITEMS).read().forEach(function (di) {
      var d = distMap[di.distributionId];
      if (!d) return;
      var q = toNum(di.quantity);
      if (d.status === STATUS.DISTRIBUTION.RECEIVED) {
        receivedBy[di.itemId] = (receivedBy[di.itemId] || 0) + q;
        if ((!from && !to) || inDateRange(d.receivedAt || d.createdAt, from, to)) periodReceivedBy[di.itemId] = (periodReceivedBy[di.itemId] || 0) + q;
      } else if (d.status === STATUS.DISTRIBUTION.RELEASED) {
        inTransitBy[di.itemId] = (inTransitBy[di.itemId] || 0) + q;
      }
    });
    var reqs = table(SHEETS.REQUESTS).read().filter(function (r) { return r.congregationId === cong.congregationId; });
    var openReq = {};
    reqs.forEach(function (r) { if ([STATUS.REQUEST.APPROVED, STATUS.REQUEST.PARTIALLY_FULFILLED].indexOf(r.status) !== -1) openReq[r.requestId] = true; });
    var outstandingBy = {};
    table(SHEETS.REQUEST_ITEMS).read().forEach(function (ri) {
      if (!openReq[ri.requestId]) return;
      outstandingBy[ri.itemId] = (outstandingBy[ri.itemId] || 0) + Math.max(0, toNum(ri.approvedQty) - toNum(ri.fulfilledQty));
    });
    var itemIds = uniq(Object.keys(receivedBy).concat(Object.keys(inTransitBy), Object.keys(outstandingBy)));
    out.items = itemIds.map(function (id) {
      var i = itemMap[id] || {};
      return { itemId: id, sku: i.sku || '', name: i.name || '', unit: i.unit || 'pcs', receivedQty: receivedBy[id] || 0, periodReceivedQty: periodReceivedBy[id] || 0,
        inTransitQty: inTransitBy[id] || 0, outstandingQty: outstandingBy[id] || 0 };
    });
    out.items = sortRows(out.items, 'name', 'asc');
    out.totals = {
      receivedQty: out.items.reduce(function (s, i) { return s + i.receivedQty; }, 0),
      periodReceivedQty: out.items.reduce(function (s, i) { return s + i.periodReceivedQty; }, 0),
      inTransitQty: out.items.reduce(function (s, i) { return s + i.inTransitQty; }, 0),
      outstandingQty: out.items.reduce(function (s, i) { return s + i.outstandingQty; }, 0)
    };
    out.requests = sortRows(reqs.filter(function (r) { return (!from && !to) || inDateRange(r.requestDate, from, to); })
      .map(function (r) { return publicRequest(r, congs, itemMap, false); }), 'requestDate', 'desc');
    out.distributions = sortRows(dists.filter(function (d) { return (!from && !to) || inDateRange(d.createdAt, from, to); })
      .map(function (d) { return publicDistribution(d, congs, itemMap, indexBy(reqs, 'requestId'), false); }), 'createdAt', 'desc');
  }
  return out;
}


// ===================== 12_Reports.js =====================
/**
 * 12_Reports.js
 * Tabular reports. Every report returns { title, columns:[{key,label}], rows:[...], generatedAt, filters }
 * so the frontend can render, print and export CSV uniformly. Rows come from the ledger and the
 * transactional sheets; nothing is hardcoded.
 */

function reportsRun(params, ctx) {
  var scope;
  if (hasPermission(ctx.user, 'reports.view')) scope = { all: true, congregationId: null };
  else scope = requireScope(ctx.user, 'reports.view', 'reports.view.own');
  var type = requireString(params, 'type', 'Report type');
  var from = params.from ? toIsoDate(params.from) : '', to = params.to ? toIsoDate(params.to) : '';
  var congregationId = scope.all ? (params.congregationId || '') : scope.congregationId;
  var filters = { from: from, to: to, congregationId: congregationId };
  var builders = {
    inventory: reportInventory, lowStock: reportLowStock, deliveries: reportDeliveries, distributions: reportDistributions,
    requests: reportRequests, transactions: reportTransactions, congregationSummary: reportCongregationSummary, monthly: reportMonthly,
    legacyEastInventory: reportLegacyEastInventory, legacyDistribution: reportLegacyDistribution
  };
  var ownAllowed = ['distributions', 'requests', 'congregationSummary'];
  if (!scope.all && ownAllowed.indexOf(type) === -1) fail(ERR.FORBIDDEN, 'This report is not available for your role.', 403);
  var builder = builders[type];
  if (!builder) fail(ERR.VALIDATION, 'Unknown report type: ' + type);
  var report = builder(filters, ctx);
  report.type = type;
  report.generatedAt = nowIso();
  report.generatedBy = ctx.user.email;
  report.filters = filters;
  return report;
}

function reportInventory(f) {
  var balances = getBalances();
  var rows = table(SHEETS.ITEMS).read().filter(function (i) { return toBool(i.active); }).map(function (i) {
    var p = publicItem(i, balances[i.itemId]);
    return { sku: p.sku, name: p.name, category: p.category, unit: p.unit, physicalQty: p.physicalQty, reservedQty: p.reservedQty, availableQty: p.availableQty, minStock: p.lowStockThreshold, lowStock: p.isLowStock ? 'Yes' : 'No', lastMovementAt: p.lastMovementAt };
  });
  return { title: 'Current Inventory (East Congregation)', columns: cols(['sku:Item Code', 'name:Literature', 'category:Category', 'unit:Unit', 'physicalQty:Physical', 'reservedQty:Reserved', 'availableQty:Available', 'minStock:Min Stock', 'lowStock:Low Stock', 'lastMovementAt:Last Movement']), rows: sortRows(rows, 'name', 'asc') };
}

function reportLowStock(f) {
  var inv = reportInventory(f);
  inv.title = 'Low-Stock Items';
  inv.rows = inv.rows.filter(function (r) { return r.lowStock === 'Yes'; });
  return inv;
}

function reportDeliveries(f) {
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var deliveries = indexBy(table(SHEETS.DELIVERIES).read().filter(function (d) {
    if ((f.from || f.to) && !inDateRange(d.deliveryDate, f.from, f.to)) return false;
    if (f.congregationId && d.sourceCongregationId !== f.congregationId) return false;
    return true;
  }), 'deliveryId');
  var rows = [];
  table(SHEETS.DELIVERY_ITEMS).read().forEach(function (di) {
    var d = deliveries[di.deliveryId]; if (!d || toNum(di.quantity) <= 0) return;
    var i = items[di.itemId] || {};
    rows.push({ reference: d.reference, deliveryDate: toIsoDate(d.deliveryDate), source: d.sourceType === 'congregation' && congs[d.sourceCongregationId] ? congs[d.sourceCongregationId].name : d.sourceName, sku: i.sku || '', name: i.name || '', quantity: toNum(di.quantity), status: d.status, receivedBy: d.receivedBy, confirmedAt: d.confirmedAt || '' });
  });
  return { title: 'Incoming Deliveries', columns: cols(['reference:Reference', 'deliveryDate:Date', 'source:Source', 'sku:Item Code', 'name:Literature', 'quantity:Qty', 'status:Status', 'receivedBy:Received By', 'confirmedAt:Confirmed At']), rows: sortRows(rows, 'deliveryDate', 'desc') };
}

function reportDistributions(f) {
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var requests = indexBy(table(SHEETS.REQUESTS).read(), 'requestId');
  var dists = indexBy(table(SHEETS.DISTRIBUTIONS).read().filter(function (d) {
    if (d.status === STATUS.DISTRIBUTION.FAILED) return false;
    if ((f.from || f.to) && !inDateRange(d.createdAt, f.from, f.to)) return false;
    if (f.congregationId && d.destinationCongregationId !== f.congregationId) return false;
    return true;
  }), 'distributionId');
  var rows = [];
  table(SHEETS.DISTRIBUTION_ITEMS).read().forEach(function (x) {
    var d = dists[x.distributionId]; if (!d) return;
    var i = items[x.itemId] || {}; var r = requests[d.requestId];
    rows.push({ reference: d.reference, date: toIsoDate(d.createdAt), destination: (congs[d.destinationCongregationId] || {}).name || '', requestNumber: r ? r.requestNumber : '', sku: i.sku || '', name: i.name || '', quantity: toNum(x.quantity), status: d.status, releasedBy: d.releasedBy, receivedAt: d.receivedAt || '' });
  });
  return { title: 'Distribution History', columns: cols(['reference:Reference', 'date:Date', 'destination:Congregation', 'requestNumber:Request', 'sku:Item Code', 'name:Literature', 'quantity:Qty', 'status:Status', 'releasedBy:Released By', 'receivedAt:Received At']), rows: sortRows(rows, 'date', 'desc') };
}

function reportRequests(f) {
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var items = indexBy(table(SHEETS.ITEMS).read(), 'itemId');
  var reqs = indexBy(table(SHEETS.REQUESTS).read().filter(function (r) {
    if ((f.from || f.to) && !inDateRange(r.requestDate, f.from, f.to)) return false;
    if (f.congregationId && r.congregationId !== f.congregationId) return false;
    return true;
  }), 'requestId');
  var rows = [];
  table(SHEETS.REQUEST_ITEMS).read().forEach(function (ri) {
    var r = reqs[ri.requestId]; if (!r || toNum(ri.requestedQty) <= 0) return;
    var i = items[ri.itemId] || {};
    rows.push({ requestNumber: r.requestNumber, requestDate: toIsoDate(r.requestDate), congregation: (congs[r.congregationId] || {}).name || '', sku: i.sku || '', name: i.name || '', requestedQty: toNum(ri.requestedQty), approvedQty: toNum(ri.approvedQty), fulfilledQty: toNum(ri.fulfilledQty), remainingQty: Math.max(0, toNum(ri.approvedQty) - toNum(ri.fulfilledQty)), status: r.status, requestedBy: r.requestedBy, approvedBy: r.approvedBy });
  });
  return { title: 'Requests and Fulfilment', columns: cols(['requestNumber:Request', 'requestDate:Date', 'congregation:Congregation', 'sku:Item Code', 'name:Literature', 'requestedQty:Requested', 'approvedQty:Approved', 'fulfilledQty:Fulfilled', 'remainingQty:Remaining', 'status:Status', 'requestedBy:Requested By', 'approvedBy:Decided By']), rows: sortRows(rows, 'requestDate', 'desc') };
}

function reportTransactions(f) {
  var rows = listTransactions({ from: f.from, to: f.to, congregationId: f.congregationId }).map(function (t) {
    return { timestamp: t.timestamp, type: t.type, sku: t.sku, name: t.itemName, quantity: t.quantity, counterparty: t.counterpartyName, refType: t.refType, refId: t.refId, actor: t.actor, notes: t.notes };
  });
  return { title: 'Stock Movements (Ledger)', columns: cols(['timestamp:Timestamp', 'type:Type', 'sku:Item Code', 'name:Literature', 'quantity:Qty (+/-)', 'counterparty:Counterparty', 'refType:Ref Type', 'refId:Ref ID', 'actor:Actor', 'notes:Notes']), rows: sortRows(rows, 'timestamp', 'desc') };
}

/** One row per congregation: what East released to them and what they confirmed, plus open requests. No double counting with East stock. */
function reportCongregationSummary(f) {
  var congs = table(SHEETS.CONGREGATIONS).read().filter(function (c) { return toBool(c.active) && (!f.congregationId || c.congregationId === f.congregationId); });
  var coordinator = getCoordinatorCongregation();
  var dists = table(SHEETS.DISTRIBUTIONS).read().filter(function (d) { return d.status !== STATUS.DISTRIBUTION.FAILED && d.status !== STATUS.DISTRIBUTION.PROCESSING && ((!f.from && !f.to) || inDateRange(d.createdAt, f.from, f.to)); });
  var distMap = indexBy(dists, 'distributionId');
  var released = {}, received = {}, inTransit = {}, count = {};
  table(SHEETS.DISTRIBUTION_ITEMS).read().forEach(function (x) {
    var d = distMap[x.distributionId]; if (!d) return;
    var c = d.destinationCongregationId, q = toNum(x.quantity);
    released[c] = (released[c] || 0) + q;
    if (d.status === STATUS.DISTRIBUTION.RECEIVED) received[c] = (received[c] || 0) + q; else inTransit[c] = (inTransit[c] || 0) + q;
  });
  dists.forEach(function (d) { count[d.destinationCongregationId] = (count[d.destinationCongregationId] || 0) + 1; });
  var reqs = table(SHEETS.REQUESTS).read().filter(function (r) { return (!f.from && !f.to) || inDateRange(r.requestDate, f.from, f.to); });
  var open = {}, pending = {}, reqCount = {};
  var openIds = {};
  reqs.forEach(function (r) {
    reqCount[r.congregationId] = (reqCount[r.congregationId] || 0) + 1;
    if (r.status === STATUS.REQUEST.PENDING) pending[r.congregationId] = (pending[r.congregationId] || 0) + 1;
    if ([STATUS.REQUEST.APPROVED, STATUS.REQUEST.PARTIALLY_FULFILLED].indexOf(r.status) !== -1) openIds[r.requestId] = r.congregationId;
  });
  table(SHEETS.REQUEST_ITEMS).read().forEach(function (ri) { var c = openIds[ri.requestId]; if (c) open[c] = (open[c] || 0) + Math.max(0, toNum(ri.approvedQty) - toNum(ri.fulfilledQty)); });
  var balances = getBalances();
  var eastPhysical = 0, eastReserved = 0;
  Object.keys(balances).forEach(function (k) { eastPhysical += balances[k].physicalQty; eastReserved += balances[k].reservedQty; });
  var rows = congs.map(function (c) {
    var isCoord = c.congregationId === coordinator.congregationId;
    return { congregation: c.name, role: isCoord ? 'Coordinator (holds stock)' : 'Member', physicalQty: isCoord ? eastPhysical : '', reservedQty: isCoord ? eastReserved : '', releasedQty: isCoord ? '' : (released[c.congregationId] || 0), receivedQty: isCoord ? '' : (received[c.congregationId] || 0), inTransitQty: isCoord ? '' : (inTransit[c.congregationId] || 0), outstandingQty: isCoord ? '' : (open[c.congregationId] || 0), pendingRequests: isCoord ? '' : (pending[c.congregationId] || 0), requests: isCoord ? '' : (reqCount[c.congregationId] || 0), distributions: isCoord ? '' : (count[c.congregationId] || 0) };
  });
  return { title: 'Congregation Stock Summary', columns: cols(['congregation:Congregation', 'role:Role', 'physicalQty:Physical (East)', 'reservedQty:Reserved (East)', 'releasedQty:Released to', 'receivedQty:Confirmed Received', 'inTransitQty:In Transit', 'outstandingQty:Outstanding Approved', 'pendingRequests:Pending Requests', 'requests:Requests', 'distributions:Distributions']), rows: rows };
}

function reportMonthly(f) {
  var txns = listTransactions({ from: f.from, to: f.to, congregationId: f.congregationId });
  var byMonth = {};
  txns.forEach(function (t) {
    var m = monthKey(t.timestamp); if (!m) return;
    var row = byMonth[m] || (byMonth[m] = { month: m, deliveredQty: 0, openingQty: 0, distributedQty: 0, adjustedQty: 0, netChange: 0, transactions: 0 });
    row.transactions += 1; row.netChange += t.quantity;
    if (t.type === TXN_TYPES.DELIVERY_IN) row.deliveredQty += t.quantity;
    else if (t.type === TXN_TYPES.OPENING_BALANCE) row.openingQty += t.quantity;
    else if (t.type === TXN_TYPES.DISTRIBUTION_OUT) row.distributedQty += Math.abs(t.quantity);
    else row.adjustedQty += t.quantity;
  });
  var rows = Object.keys(byMonth).sort().reverse().map(function (m) { return byMonth[m]; });
  return { title: 'Monthly Summary', columns: cols(['month:Month', 'deliveredQty:Delivered In', 'openingQty:Opening Balances', 'distributedQty:Distributed Out', 'adjustedQty:Adjustments', 'netChange:Net Change', 'transactions:Transactions']), rows: rows };
}

/** Legacy worksheets, read only, preserved for the original monthly report. */
function reportLegacyEastInventory(f) {
  var data = readLegacySheet(CONFIG.LEGACY_SHEETS.EAST_INVENTORY);
  var rows = data.rows.filter(function (r) { return (!f.from && !f.to) || inDateRange(r.Date, f.from, f.to); });
  return { title: 'Legacy East_Inventory worksheet', columns: data.headers.map(function (h) { return { key: h, label: h }; }), rows: rows };
}

function reportLegacyDistribution(f) {
  var data = readLegacySheet(CONFIG.LEGACY_SHEETS.DISTRIBUTION);
  var congName = f.congregationId ? (table(SHEETS.CONGREGATIONS).findById(f.congregationId) || {}).code : '';
  var rows = data.rows.filter(function (r) {
    if ((f.from || f.to) && !inDateRange(r.Date, f.from, f.to)) return false;
    if (congName && String(r.Congregation || '').toUpperCase() !== String(congName).toUpperCase()) return false;
    return true;
  });
  return { title: 'Legacy Distribution worksheet', columns: data.headers.map(function (h) { return { key: h, label: h }; }), rows: rows };
}

function cols(specs) {
  return specs.map(function (s) { var p = s.split(':'); return { key: p[0], label: p[1] || p[0] }; });
}


// ===================== 13_Dashboard.js =====================
/**
 * 13_Dashboard.js
 * Live summary figures computed from the sheets. Nothing here is hardcoded.
 */

function dashboardSummary(params, ctx) {
  requirePermission(ctx.user, 'dashboard.view');
  var from = params.from ? toIsoDate(params.from) : '', to = params.to ? toIsoDate(params.to) : '';
  var congregationFilter = params.congregationId || '';
  var isCongUser = ctx.user.role === ROLES.CONGREGATION_USER;
  if (isCongUser) congregationFilter = ctx.user.congregationId || '__none__';

  var items = table(SHEETS.ITEMS).read().filter(function (i) { return toBool(i.active); });
  var balances = getBalances();
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var coordinator = getCoordinatorCongregation();

  var stock = { uniqueItems: items.length, physicalQty: 0, reservedQty: 0, availableQty: 0, lowStockCount: 0, lowStockItems: [] };
  var threshold = toNum(getSetting('defaultLowStockThreshold'), 10);
  items.forEach(function (i) {
    var b = balances[i.itemId] || { physicalQty: 0, reservedQty: 0, availableQty: 0 };
    stock.physicalQty += b.physicalQty; stock.reservedQty += b.reservedQty; stock.availableQty += b.availableQty;
    var min = i.minStock === '' || i.minStock === undefined ? threshold : toNum(i.minStock);
    if (b.physicalQty <= min) { stock.lowStockCount += 1; stock.lowStockItems.push({ itemId: i.itemId, sku: i.sku, name: i.name, physicalQty: b.physicalQty, availableQty: b.availableQty, minStock: min }); }
  });
  stock.lowStockItems = sortRows(stock.lowStockItems, 'physicalQty', 'asc').slice(0, 10);

  var deliveries = table(SHEETS.DELIVERIES).read().filter(function (d) { return (!from && !to) || inDateRange(d.deliveryDate, from, to); });
  var deliveryStats = { pending: 0, confirmed: 0, cancelled: 0, confirmedQty: 0 };
  var deliveryQty = {};
  table(SHEETS.DELIVERY_ITEMS).read().forEach(function (di) { deliveryQty[di.deliveryId] = (deliveryQty[di.deliveryId] || 0) + toNum(di.quantity); });
  deliveries.forEach(function (d) {
    if (d.status === STATUS.DELIVERY.PENDING) deliveryStats.pending += 1;
    else if (d.status === STATUS.DELIVERY.CONFIRMED) { deliveryStats.confirmed += 1; deliveryStats.confirmedQty += deliveryQty[d.deliveryId] || 0; }
    else deliveryStats.cancelled += 1;
  });

  var requests = table(SHEETS.REQUESTS).read().filter(function (r) {
    if (congregationFilter && r.congregationId !== congregationFilter) return false;
    return (!from && !to) || inDateRange(r.requestDate, from, to);
  });
  var requestStats = { draft: 0, pending: 0, approved: 0, partiallyFulfilled: 0, fulfilled: 0, rejected: 0, cancelled: 0, awaitingFulfilment: 0 };
  requests.forEach(function (r) {
    switch (r.status) {
      case STATUS.REQUEST.DRAFT: requestStats.draft += 1; break;
      case STATUS.REQUEST.PENDING: requestStats.pending += 1; break;
      case STATUS.REQUEST.APPROVED: requestStats.approved += 1; requestStats.awaitingFulfilment += 1; break;
      case STATUS.REQUEST.PARTIALLY_FULFILLED: requestStats.partiallyFulfilled += 1; requestStats.awaitingFulfilment += 1; break;
      case STATUS.REQUEST.FULFILLED: requestStats.fulfilled += 1; break;
      case STATUS.REQUEST.REJECTED: requestStats.rejected += 1; break;
      case STATUS.REQUEST.CANCELLED: requestStats.cancelled += 1; break;
    }
  });

  var dists = table(SHEETS.DISTRIBUTIONS).read().filter(function (d) {
    if (d.status === STATUS.DISTRIBUTION.FAILED || d.status === STATUS.DISTRIBUTION.PROCESSING) return false;
    if (congregationFilter && d.destinationCongregationId !== congregationFilter) return false;
    return (!from && !to) || inDateRange(d.createdAt, from, to);
  });
  var distMap = indexBy(dists, 'distributionId');
  var distStats = { released: 0, received: 0, totalQty: 0 };
  var byCong = {};
  dists.forEach(function (d) {
    if (d.status === STATUS.DISTRIBUTION.RECEIVED) distStats.received += 1; else distStats.released += 1;
    var c = byCong[d.destinationCongregationId] || (byCong[d.destinationCongregationId] = { congregationId: d.destinationCongregationId, name: (congs[d.destinationCongregationId] || {}).name || '', distributions: 0, releasedQty: 0, receivedQty: 0 });
    c.distributions += 1;
  });
  table(SHEETS.DISTRIBUTION_ITEMS).read().forEach(function (x) {
    var d = distMap[x.distributionId]; if (!d) return;
    var q = toNum(x.quantity);
    distStats.totalQty += q;
    var c = byCong[d.destinationCongregationId];
    if (c) { c.releasedQty += q; if (d.status === STATUS.DISTRIBUTION.RECEIVED) c.receivedQty += q; }
  });
  var distributionByCongregation = Object.keys(byCong).map(function (k) { return byCong[k]; });
  // include congregations with zero activity so the summary is complete
  Object.keys(congs).forEach(function (id) {
    var c = congs[id];
    if (id === coordinator.congregationId || !toBool(c.active)) return;
    if (congregationFilter && id !== congregationFilter) return;
    if (!byCong[id]) distributionByCongregation.push({ congregationId: id, name: c.name, distributions: 0, releasedQty: 0, receivedQty: 0 });
  });
  distributionByCongregation = sortRows(distributionByCongregation, 'name', 'asc');

  var recent = isCongUser ? [] : sortRows(listTransactions({ from: from, to: to, congregationId: congregationFilter }), 'timestamp', 'desc').slice(0, 12);

  return {
    generatedAt: nowIso(), from: from, to: to, congregationId: congregationFilter === '__none__' ? '' : congregationFilter,
    coordinator: { congregationId: coordinator.congregationId, name: coordinator.name, code: coordinator.code },
    stock: isCongUser ? { uniqueItems: stock.uniqueItems, physicalQty: null, reservedQty: null, availableQty: null, lowStockCount: null, lowStockItems: [] } : stock,
    deliveries: isCongUser ? { pending: null, confirmed: null, cancelled: null, confirmedQty: null } : deliveryStats,
    requests: requestStats, distributions: distStats, distributionByCongregation: distributionByCongregation, recentTransactions: recent,
    reserveOnApproval: getSettingBool('reserveOnApproval')
  };
}


// ===================== 14_Users.js =====================
/**
 * 14_Users.js
 * Administrator-only user management and application settings.
 */

function usersList(params, ctx) {
  requirePermission(ctx.user, 'users.manage');
  var congs = indexBy(table(SHEETS.CONGREGATIONS).read(), 'congregationId');
  var rows = table(SHEETS.USERS).read().map(function (u) { return publicUser(u, congs[u.congregationId]); })
    .filter(function (u) {
      if (params.role && u.role !== params.role) return false;
      if (params.active !== undefined && params.active !== '' && u.active !== toBool(params.active)) return false;
      return textMatches(u, ['email', 'name', 'role', 'congregationName'], params.query);
    });
  rows = sortRows(rows, params.sortBy || 'email', params.sortDir || 'asc');
  return paginate(rows, params);
}

function validateRole(role) {
  if (ALL_ROLES.indexOf(role) === -1) fail(ERR.VALIDATION, 'Role must be one of: ' + ALL_ROLES.join(', ') + '.');
  return role;
}

function validateUserCongregation(role, congregationId) {
  if (role === ROLES.CONGREGATION_USER) {
    var c = requireCongregation(congregationId, 'Congregation');
    return c.congregationId;
  }
  if (isNonEmptyString(congregationId)) return requireCongregation(congregationId, 'Congregation').congregationId;
  return '';
}

function countActiveAdmins(exceptUserId) {
  return table(SHEETS.USERS).read().filter(function (u) { return u.role === ROLES.ADMIN && toBool(u.active) && u.userId !== exceptUserId; }).length;
}

function usersCreate(params, ctx) {
  requirePermission(ctx.user, 'users.manage');
  var email = normalizeEmail(requireString(params, 'email', 'Email', 160));
  if (!isValidEmail(email)) fail(ERR.VALIDATION, 'Enter a valid Google account email address.');
  if (findUserByEmail(email)) fail(ERR.CONFLICT, 'This email address is already authorized.', 409);
  var role = validateRole(optionalString(params, 'role') || ROLES.READ_ONLY);
  var congregationId = validateUserCongregation(role, params.congregationId);
  var now = nowIso();
  var u = {
    userId: newId('usr'), email: email, name: optionalString(params, 'name', 120), role: role, congregationId: congregationId,
    active: 'TRUE', createdAt: now, createdBy: ctx.user.email, updatedAt: now, updatedBy: ctx.user.email, lastLoginAt: ''
  };
  table(SHEETS.USERS).append(u);
  invalidateUserCache(email);
  writeAudit(ctx.user.email, 'users.create', 'AuthorizedUsers', u.userId, 'Authorized ' + email + ' as ' + role, ctx.requestId, { role: role, congregationId: congregationId });
  return publicUser(u, congregationId ? table(SHEETS.CONGREGATIONS).findById(congregationId) : null);
}

function usersUpdate(params, ctx) {
  requirePermission(ctx.user, 'users.manage');
  var t = table(SHEETS.USERS);
  var u = t.findById(params.userId);
  if (!u) fail(ERR.NOT_FOUND, 'User not found.', 404);
  var role = params.role === undefined ? u.role : validateRole(params.role);
  var congregationId = params.congregationId === undefined && params.role === undefined ? (u.congregationId || '') : validateUserCongregation(role, params.congregationId === undefined ? u.congregationId : params.congregationId);
  var active = params.active === undefined ? toBool(u.active) : toBool(params.active);
  var isSelf = u.userId === ctx.user.userId;
  if (isSelf && !active) fail(ERR.VALIDATION, 'You cannot deactivate your own account.');
  if (isSelf && role !== ROLES.ADMIN) fail(ERR.VALIDATION, 'You cannot remove your own administrator role.');
  if (u.role === ROLES.ADMIN && toBool(u.active) && (role !== ROLES.ADMIN || !active) && countActiveAdmins(u.userId) === 0) {
    fail(ERR.VALIDATION, 'At least one active administrator must remain.');
  }
  var now = nowIso();
  var saved = t.update(u.userId, { name: params.name === undefined ? u.name : optionalString(params, 'name', 120), role: role, congregationId: congregationId, active: active ? 'TRUE' : 'FALSE', updatedAt: now, updatedBy: ctx.user.email });
  invalidateUserCache(saved.email);
  writeAudit(ctx.user.email, 'users.update', 'AuthorizedUsers', saved.userId, 'Updated ' + saved.email + ' (' + role + ', ' + (active ? 'active' : 'inactive') + ')', ctx.requestId, { role: role, active: active, congregationId: congregationId });
  return publicUser(saved, congregationId ? table(SHEETS.CONGREGATIONS).findById(congregationId) : null);
}

/* ---------- Settings ---------- */

function settingsGet(params, ctx) {
  // Non-sensitive application behaviour flags; any authenticated user may read them.
  var map = getSettings();
  var meta = indexBy(DEFAULT_SETTINGS, 'key');
  return Object.keys(map).map(function (k) { return { key: k, value: map[k], description: meta[k] ? meta[k].description : '' }; });
}

function settingsUpdate(params, ctx) {
  requirePermission(ctx.user, 'settings.manage');
  var key = requireString(params, 'key', 'Setting key', 60);
  var allowed = DEFAULT_SETTINGS.map(function (s) { return s.key; });
  if (allowed.indexOf(key) === -1) fail(ERR.VALIDATION, 'Unknown setting: ' + key);
  var value = String(params.value === undefined || params.value === null ? '' : params.value).trim();
  if (['reserveOnApproval', 'allowAdHocDistribution'].indexOf(key) !== -1 && ['true', 'false'].indexOf(value.toLowerCase()) === -1) fail(ERR.VALIDATION, key + ' must be true or false.');
  if (key === 'defaultLowStockThreshold') value = String(requireNonNegativeInt(value, 'Low stock threshold'));
  if (/Prefix$/.test(key) && !/^[A-Z0-9]{1,8}$/.test(value)) fail(ERR.VALIDATION, 'Prefixes must be 1-8 uppercase letters or digits.');
  var t = table(SHEETS.SETTINGS);
  var existing = t.findById(key);
  var meta = indexBy(DEFAULT_SETTINGS, 'key')[key];
  var now = nowIso();
  if (existing) t.update(key, { value: value, updatedAt: now, updatedBy: ctx.user.email });
  else t.append({ key: key, value: value, description: meta.description, updatedAt: now, updatedBy: ctx.user.email });
  invalidateSettingsCache();
  writeAudit(ctx.user.email, 'settings.update', 'AppSettings', key, 'Set ' + key + ' = ' + value, ctx.requestId, null);
  return settingsGet(params, ctx);
}


// ===================== 20_Api.js =====================
/**
 * 20_Api.js
 * Web app entry points and the action router.
 *
 * Transport: the SPA sends a POST with a text/plain body (so the browser does not issue a CORS
 * preflight, which Apps Script cannot answer). Body:
 *   { "action": "items.list", "token": "<session token>", "requestId": "<uuid>", "params": { ... } }
 * Response (always HTTP 200 from Apps Script; success is in the body):
 *   { "success": true|false, "data": ..., "message": "", "error": { "code", "message" } | null, "requestId": "<uuid>" }
 */

var ACTIONS = {
  'health':                       { handler: healthAction, isPublic: true },
  'auth.login':                   { handler: authLogin, isPublic: true, mutation: false },
  'auth.me':                      { handler: authMe },
  'auth.logout':                  { handler: authLogout },

  'dashboard.summary':            { handler: dashboardSummary },

  'congregations.list':           { handler: congregationsList },
  'congregations.save':           { handler: congregationsSave, mutation: true },

  'items.list':                   { handler: itemsList },
  'items.get':                    { handler: itemsGet },
  'items.history':                { handler: itemsHistory },
  'items.create':                 { handler: itemsCreate, mutation: true },
  'items.update':                 { handler: itemsUpdate, mutation: true },
  'items.adjust':                 { handler: itemsAdjust, mutation: true },
  'transactions.list':            { handler: transactionsList },

  'deliveries.list':              { handler: deliveriesList },
  'deliveries.get':               { handler: deliveriesGet },
  'deliveries.create':            { handler: deliveriesCreate, mutation: true },
  'deliveries.update':            { handler: deliveriesUpdate, mutation: true },
  'deliveries.confirm':           { handler: deliveriesConfirm, mutation: true },
  'deliveries.cancel':            { handler: deliveriesCancel, mutation: true },

  'requests.list':                { handler: requestsList },
  'requests.get':                 { handler: requestsGet },
  'requests.create':              { handler: requestsCreate, mutation: true },
  'requests.update':              { handler: requestsUpdate, mutation: true },
  'requests.submit':              { handler: requestsSubmit, mutation: true },
  'requests.approve':             { handler: requestsApprove, mutation: true },
  'requests.reject':              { handler: requestsReject, mutation: true },
  'requests.cancel':              { handler: requestsCancel, mutation: true },

  'distributions.list':           { handler: distributionsList },
  'distributions.get':            { handler: distributionsGet },
  'distributions.create':         { handler: distributionsCreate, mutation: true },
  'distributions.confirmReceipt': { handler: distributionsConfirmReceipt, mutation: true },

  'stock.overview':               { handler: stockOverview },
  'reports.run':                  { handler: reportsRun },

  'users.list':                   { handler: usersList },
  'users.create':                 { handler: usersCreate, mutation: true },
  'users.update':                 { handler: usersUpdate, mutation: true },
  'audit.list':                   { handler: auditList },
  'settings.get':                 { handler: settingsGet },
  'settings.update':              { handler: settingsUpdate, mutation: true },
  'admin.reconcile':              { handler: adminReconcile, mutation: true },
  'admin.importLegacyOpeningBalances': { handler: adminImportLegacyOpeningBalances, mutation: true }
};

function healthAction() {
  return { service: CONFIG.APP_NAME, version: CONFIG.APP_VERSION, time: nowIso() };
}

/** Core dispatcher. Pure function of the request body; used by doPost and by the test harness. */
function handleRequest(body) {
  resetAllCaches();
  var requestId = body && typeof body.requestId === 'string' ? body.requestId.slice(0, 128) : null;
  try {
    if (!body || typeof body !== 'object') fail(ERR.VALIDATION, 'Request body must be a JSON object.');
    var action = body.action;
    var def = typeof action === 'string' ? ACTIONS[action] : null;
    if (!def) fail(ERR.NOT_FOUND, 'Unknown action.', 404);
    var params = body.params && typeof body.params === 'object' ? body.params : {};
    var ctx = { requestId: requestId, action: action, user: null };
    if (!def.isPublic) ctx.user = authenticate(body.token);
    var data = def.mutation ? runMutation(action, ctx, function () { return def.handler(params, ctx); }) : def.handler(params, ctx);
    return ok(data, '', requestId);
  } catch (err) {
    return errorResponse(err, requestId);
  }
}

function jsonOutput(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  var body = null;
  try {
    var raw = e && e.postData && e.postData.contents ? e.postData.contents : '';
    if (raw.length > 1000000) return jsonOutput(errorResponse(new AppError(ERR.VALIDATION, 'Request too large.'), null));
    body = raw ? JSON.parse(raw) : null;
  } catch (err) {
    return jsonOutput(errorResponse(new AppError(ERR.VALIDATION, 'Request body must be valid JSON.'), null));
  }
  return jsonOutput(handleRequest(body));
}

function doGet(e) {
  // Health check only. No data is ever served over GET.
  return jsonOutput(ok(healthAction(), 'OK', null));
}


// ===================== 99_Setup.js =====================
/**
 * 99_Setup.js
 * One-time and maintenance functions run manually from the Apps Script editor by the script owner.
 * None of these are reachable from the web app except admin.importLegacyOpeningBalances (admin role, dry-run by default).
 */

/**
 * Run once after deploying the script and granting permissions:
 *  - creates missing worksheets/columns (never touches East_Inventory or Distribution)
 *  - generates SESSION_SECRET if absent
 *  - seeds congregations, default settings and the initial administrator
 * Then set GOOGLE_CLIENT_ID (and optionally SPREADSHEET_ID) in Project Settings > Script Properties.
 */
function setup() {
  var props = getProps();
  var created = ensureSchema();
  if (!props.getProperty('SESSION_SECRET')) {
    props.setProperty('SESSION_SECRET', generateSecret());
    console.log('Generated SESSION_SECRET.');
  }
  resetSheetCaches();
  var congTable = table(SHEETS.CONGREGATIONS);
  if (congTable.count() === 0) {
    var now = nowIso();
    congTable.append(DEFAULT_CONGREGATIONS.map(function (c) {
      return { congregationId: newId('cong'), code: c.code, name: c.name, type: c.type, active: 'TRUE', notes: '', createdAt: now, updatedAt: now };
    }));
    console.log('Seeded ' + DEFAULT_CONGREGATIONS.length + ' congregations.');
  }
  var settings = table(SHEETS.SETTINGS);
  var existingKeys = settings.read().map(function (s) { return s.key; });
  var missing = DEFAULT_SETTINGS.filter(function (s) { return existingKeys.indexOf(s.key) === -1; });
  if (missing.length) {
    settings.append(missing.map(function (s) { return { key: s.key, value: s.value, description: s.description, updatedAt: nowIso(), updatedBy: 'setup' }; }));
    invalidateSettingsCache();
  }
  var admin = seedInitialAdmin('setup');
  if (admin) console.log('Seeded initial administrator: ' + admin.email);
  var summary = {
    spreadsheetId: getSpreadsheetId(),
    schema: created,
    googleClientIdConfigured: !!props.getProperty('GOOGLE_CLIENT_ID'),
    sessionSecretConfigured: !!props.getProperty('SESSION_SECRET')
  };
  console.log(JSON.stringify(summary, null, 2));
  return summary;
}

/** Invalidates all existing sessions by rotating the HMAC secret. */
function rotateSessionSecret() {
  getProps().setProperty('SESSION_SECRET', generateSecret());
  console.log('SESSION_SECRET rotated; all users must sign in again.');
}

function generateSecret() {
  // 64 random bytes -> base64 (88 chars). Utilities.getUuid is not cryptographically ideal on its own,
  // so we hash several together with a timestamp to widen the entropy pool.
  var seed = [Utilities.getUuid(), Utilities.getUuid(), Utilities.getUuid(), Utilities.getUuid(), String(Date.now()), String(Math.random())].join('|');
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_512, seed, Utilities.Charset.UTF_8);
  return Utilities.base64Encode(bytes);
}

/** Quick diagnostic you can run from the editor. */
function healthCheck() {
  var props = getProps();
  var ss = getSpreadsheet();
  var result = {
    spreadsheet: ss.getName(),
    sheets: ss.getSheets().map(function (s) { return s.getName() + ' (' + Math.max(0, s.getLastRow() - 1) + ' rows)'; }),
    googleClientIdConfigured: !!props.getProperty('GOOGLE_CLIENT_ID'),
    sessionSecretConfigured: !!props.getProperty('SESSION_SECRET'),
    coordinator: (function () { try { return getCoordinatorCongregation().name; } catch (e) { return 'NOT CONFIGURED'; } })(),
    users: table(SHEETS.USERS).count()
  };
  console.log(JSON.stringify(result, null, 2));
  return result;
}

/**
 * Proposed migration: load the latest month of the legacy East_Inventory sheet as OPENING_BALANCE
 * transactions for matching item codes. Dry run unless params.apply === true. Appends only; never edits
 * legacy rows. Items are matched by SKU == "Literature Code"; unmatched codes are reported, not created,
 * unless params.createMissingItems === true.
 */
function adminImportLegacyOpeningBalances(params, ctx) {
  requirePermission(ctx.user, 'admin.reconcile');
  var apply = toBool(params.apply);
  var legacy = readLegacySheet(CONFIG.LEGACY_SHEETS.EAST_INVENTORY);
  if (!legacy.rows.length) fail(ERR.NOT_FOUND, 'The legacy East_Inventory worksheet is empty or missing.', 404);
  var month = params.month ? String(params.month).slice(0, 7) : legacy.rows.map(function (r) { return monthKey(r.Date); }).filter(Boolean).sort().pop();
  var rows = legacy.rows.filter(function (r) { return monthKey(r.Date) === month; });
  if (!rows.length) fail(ERR.NOT_FOUND, 'No legacy rows found for month ' + month + '.', 404);
  if (table(SHEETS.TRANSACTIONS).read().some(function (t) { return t.refType === 'LEGACY_IMPORT'; })) {
    fail(ERR.CONFLICT, 'Legacy opening balances have already been imported. Use stock adjustments for corrections.', 409);
  }
  var items = table(SHEETS.ITEMS).read();
  var bySku = {};
  items.forEach(function (i) { bySku[String(i.sku).toUpperCase()] = i; });
  var plan = [], unmatched = [];
  rows.forEach(function (r) {
    var sku = String(r['Literature Code'] || '').trim().toUpperCase();
    var qty = toNum(r.Total);
    if (!sku || qty <= 0) return;
    var item = bySku[sku];
    if (!item) { unmatched.push({ sku: sku, name: r['Literature Name'], quantity: qty }); return; }
    plan.push({ itemId: item.itemId, sku: sku, name: item.name, quantity: qty });
  });
  var report = { month: month, apply: apply, planned: plan, unmatched: unmatched, created: [] };
  if (!apply) return report;
  if (unmatched.length && toBool(params.createMissingItems)) {
    var now = nowIso();
    unmatched.forEach(function (u) {
      var item = { itemId: newId('itm'), sku: u.sku, name: u.name || u.sku, description: 'Imported from legacy East_Inventory', category: '', unit: 'pcs', minStock: 0, active: 'TRUE', createdAt: now, createdBy: ctx.user.email, updatedAt: now, updatedBy: ctx.user.email };
      table(SHEETS.ITEMS).append(item);
      table(SHEETS.BALANCES).append({ itemId: item.itemId, physicalQty: 0, lastTxnId: '', updatedAt: now });
      plan.push({ itemId: item.itemId, sku: u.sku, name: item.name, quantity: u.quantity });
      report.created.push(u.sku);
    });
    report.unmatched = [];
  }
  if (!plan.length) fail(ERR.VALIDATION, 'Nothing to import: no legacy codes match catalog items.');
  postTransactions(plan.map(function (p) {
    return { type: TXN_TYPES.OPENING_BALANCE, itemId: p.itemId, quantity: p.quantity, refType: 'LEGACY_IMPORT', refId: month, notes: 'Opening balance imported from East_Inventory ' + month };
  }), ctx);
  writeAudit(ctx.user.email, 'admin.importLegacyOpeningBalances', 'InventoryTransactions', month, 'Imported ' + plan.length + ' opening balances from legacy sheet (' + month + ')', ctx.requestId, report);
  return report;
}
