# Copy to frontend/.env.local (git-ignored) and fill in the values.
# Everything in this file is PUBLIC by design: it is bundled into the browser build.
# Never put client secrets, service account keys, API keys or session secrets here.

# "http" talks to the deployed Apps Script web app. "mock" runs the backend in the browser for local demos.
VITE_API_MODE=http

# Apps Script web app URL (Deploy > New deployment > Web app), ending in /exec
VITE_API_BASE_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Google Cloud OAuth 2.0 "Web application" client ID (public identifier, not a secret)
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com

# "/" for a custom domain or user site, "/TacKHInventory/" for GitHub project pages
VITE_BASE_PATH=/

VITE_APP_NAME=East Congregation Literature Inventory
